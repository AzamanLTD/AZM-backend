# =============================================================================
# AZAMAN BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values
# =============================================================================

# ── REQUIRED (server will NOT start without these) ────────────────────────────

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/azaman

# JWT signing key — MUST be a strong random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_min_32_chars

# ── ADMIN ACCESS ──────────────────────────────────────────────────────────────
# Set these to provision your admin account on first login.
# After the admin account is created, you can remove these for extra security.
ADMIN_SEED_EMAIL=your-admin@yourdomain.com
ADMIN_SEED_PASSWORD=YourStrongAdminPassword!2024
ADMIN_SEED_USERNAME=AzamanAdmin

# ── SECURITY ──────────────────────────────────────────────────────────────────

# JWT access token expiry. Short-lived by design (financial app): a stolen
# access token is only valid for this window. The Flutter client silently
# refreshes via POST /api/auth/refresh using its long-lived refresh token,
# so a short access expiry is transparent to users. Keep this at 15m in
# production; do not raise it. Accepts any `ms`-style duration (e.g. 15m, 1h).
# NOTE: the code reads JWT_ACCESS_EXPIRY (see services/authTokenService.js).
# The old JWT_EXPIRY name was never read and has been removed to avoid a
# false sense of control.
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime in days (opaque UUID stored in the RefreshToken
# table; rotated one-time-use on every /auth/refresh). Default 30.
JWT_REFRESH_EXPIRY_DAYS=30

# CORS allowed origins (comma-separated). Set to your frontend URLs in production.
# Example: https://app.azaman.com,https://www.azaman.com
# In production, set CORS_ORIGINS to your exact deployed domains, e.g. https://admin.azaman.app and never use wildcard in production.
CORS_ORIGINS=*

# Environment mode (production | development)
NODE_ENV=development

# Redis (optional). When set, Socket.IO uses Redis pub/sub so the backend can
# run as multiple instances (PM2 cluster / multiple dynos) and still deliver
# real-time events across all of them. When unset, the server runs single
# instance with the in-memory adapter (fine for dev and small single-box
# deploys). Format: redis://username:password@host:port
# When set, REDIS_URL is ALSO used by the rate limiter (middleware/
# rateLimitMiddleware.js) so per-IP/per-user limits are shared across instances.
# Upstash free tier works (use its ioredis URL). Local: run redis-server.
# REDIS_URL=redis://localhost:6379

# ── OBSERVABILITY ─────────────────────────────────────────────────────────────

# Sentry error monitoring (optional). When set, server.js (via instrument.js)
# reports unhandled errors + a sample of transactions to Sentry. Unset = off.
# Create a project at https://sentry.io and copy its DSN. Free tier ~5k/mo.
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── WEBHOOKS ──────────────────────────────────────────────────────────────────

# Fiat deposit webhook secret (shared with payment provider)
FIAT_WEBHOOK_SECRET=your_webhook_secret

# Tatum crypto webhook HMAC verification secret
TATUM_WEBHOOK_SECRET=your_tatum_secret

# ── EXTERNAL SERVICES ─────────────────────────────────────────────────────────

# Firebase (for push notifications)
#
# REQUIRED for FCM push notifications to work. Without this file the server
# still starts, but `utils/firebaseService.js` logs a single init error and
# `sendPushNotification` becomes a silent no-op.
#
# Setup:
#   1. In Firebase console: Project settings → Service accounts →
#      "Generate new private key". A JSON file downloads.
#   2. Save it to the BACKEND PROJECT ROOT as exactly:
#         service-account.json
#   3. Restart the server. You should see:
#         🔥 Firebase Admin SDK Initialized Successfully
#
# This file is in `.gitignore` and MUST NEVER be committed. If a key ever
# leaks, revoke it in Google Cloud IAM (Service accounts → key tab → trash)
# and generate a new one. The leaked bytes become inert the moment the key
# is revoked.
#
# Do NOT paste the JSON contents into chats, tickets, screenshots, or docs.
# Reference keys by the last 4 chars of their `private_key_id` only.

# Cloudinary — durable media storage for ALL file uploads (chat media, avatars,
# KYC/proof-of-residency docs, vendor docs, trade payment proofs).
#
# Render's local disk is EPHEMERAL — anything written under uploads/ is wiped on
# every redeploy. Uploads are streamed to Cloudinary instead, and the returned
# secure_url is what gets persisted in the DB. These MUST be set in production or
# uploaded media is lost on the next deploy. Without them the server still boots,
# but disk-buffered flows fall back to a (transient) local path and in-memory
# flows (chat media, avatars) will reject the upload with a clear error.
#
# Provide EITHER the single CLOUDINARY_URL connection string OR the three
# individual vars below (the service reads the individual vars).
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Tatum (Polygon Web3 integration)
TATUM_API_KEY=mock-key
TATUM_XPUB=mock-xpub
TATUM_PROVIDER=MOCK

# Kotani Pay (fiat on-ramp + rate oracle)
KOTANI_API_KEY=mock-key
KOTANI_PROVIDER=MOCK

# MTN MoMo (fiat off-ramp disbursement) — FALLBACK provider.
# Kept wired (commented) in server.js. Primary off-ramp is now Moolre (below).
MTN_MOMO_API_USER=mock
MTN_MOMO_API_KEY=mock
MTN_MOMO_SUBSCRIPTION_KEY=mock
MTN_MOMO_PROVIDER=MOCK
# MTN settlement webhook shared secret (header: X-Mtn-Webhook-Secret)
# MTN_WEBHOOK_SECRET=your_mtn_webhook_secret

# ── MOOLRE (PRIMARY fiat off-ramp disbursement + SMS) ─────────────────────────
#
# Moolre is the primary off-ramp provider (services/moolreDisbursementService.js),
# bound under the same app-key as MTN so every consumer (finance.controller,
# withdrawalReconciliationWorker, payoutBatchWorker, smartRouteService) uses it
# with no code change. It can ALSO back the SMS service (SMS_PROVIDER=moolre).
#
# MODE: like every AZM provider, defaults to MOCK. Set MOOLRE_PROVIDER=LIVE AND
# provide MOOLRE_API_USER + MOOLRE_API_KEY to enable real disbursement calls.
#
# AUTH: Moolre uses STATIC header credentials (no OAuth / no token exchange):
#   X-API-USER  = MOOLRE_API_USER
#   X-API-KEY   = MOOLRE_API_KEY      (disbursements/collections/wallet)
#   X-API-VASKEY= MOOLRE_VAS_KEY      (SMS / USSD — falls back to API_KEY if unset)
#
# ENV/BASE URL: MOOLRE_ENV selects sandbox vs production. Defaults to SANDBOX so
# a misconfigured prod deploy cannot move real money. Set MOOLRE_ENV=production
# (or override MOOLRE_BASE_URL directly) to go live.
#   sandbox    → https://sandbox.moolre.com
#   production → https://api.moolre.com
MOOLRE_PROVIDER=MOCK
MOOLRE_ENV=sandbox
# MOOLRE_BASE_URL=https://sandbox.moolre.com   # optional explicit override
MOOLRE_API_USER=mock
MOOLRE_API_KEY=mock
MOOLRE_VAS_KEY=mock
# Public key — used ONLY for Collections Payment Status poll + Create Payment ID.
# Every other Moolre endpoint uses X-API-KEY (private key).
MOOLRE_API_PUBKEY=mock
# The Moolre payout account/wallet number funds are disbursed FROM (required by
# most Moolre transfer endpoints). Get this from your Moolre dashboard.
MOOLRE_ACCOUNT_NUMBER=
# SMS sender ID shown to recipients (when SMS_PROVIDER=moolre).
MOOLRE_SMS_SENDER_ID=AZAMAN
# Moolre settlement callback shared secret (header: X-Moolre-Webhook-Secret).
# Point your Moolre dashboard callback URL at:
#   POST /api/finance/webhook/moolre-disbursement
# The endpoint hard-disables itself (503) if this is unset, so production never
# exposes an unauthenticated ledger mutation.
MOOLRE_WEBHOOK_SECRET=your_moolre_webhook_secret

# ── HOW TO TEST MOOLRE SANDBOX ─────────────────────────────────────────────
# 1. Register at https://sandbox.moolre.com and get your API credentials.
# 2. Set: MOOLRE_PROVIDER=LIVE, MOOLRE_ENV=sandbox
# 3. Set: MOOLRE_API_USER and MOOLRE_API_KEY from your dashboard.
# 4. Set: MOOLRE_ACCOUNT_NUMBER to your sandbox wallet/account number.
# 5. Configure your Moolre sandbox webhook URL to point at your backend:
#    POST https://your-backend.com/api/finance/webhook/moolre-disbursement
#    Set the webhook secret in your Moolre dashboard to match MOOLRE_WEBHOOK_SECRET.
#
# CONFIRMED 2026-07-09 against the official docs.moolre.com/ai/*.md reference —
# services/moolreDisbursementService.js's endpoint/field constants are correct
# as shipped (TRANSFER_ENDPOINT '/open/transact/transfer', STATUS_ENDPOINT
# '/open/transact/status', BODY_KEYS.recipient='receiver', .reference='externalref').
# One real bug WAS found and fixed in that pass: Moolre's payout status field
# is the NUMERIC data.txstatus (0=Pending, 1=Success, 2=Failed), not a word —
# the normalizer was reading a data.status field that doesn't exist on this
# endpoint, so successful payouts were stuck reporting PENDING forever.
#
# VERIFY BLOCK for SMS — if sandbox returns 404, adjust in services/smsService.js:
#   SMS endpoint: currently '/sms/send'
#   SMS_BODY_KEYS.recipient: currently 'recipient'
#   SMS_BODY_KEYS.message:   currently 'message'
#   SMS_BODY_KEYS.sender:    currently 'sender_id'
#
# 6. Test a disbursement: POST /api/finance/withdraw/fiat with a small amount.
#    Watch the logs for '[MoolreDisbursementService] Running in LIVE mode'.
# 7. Test SMS: trigger a phone OTP (POST /api/security/phone/send-otp).
#    Watch for '[SMSService] Sending via Moolre' in logs.
# 8. For webhook testing: use ngrok to expose your local server, or deploy to
#    staging first. Moolre sandbox will POST to your configured callback URL.
# ──────────────────────────────────────────────────────────────────────────

# Email (transactional receipts — Phase L1, real providers Phase Q9)
#
# Default = MOCK. In MOCK mode the server logs the email to stdout (subject,
# message id, content preview) and returns a stub success response — useful
# for local dev and CI without setting up a real SMTP/transactional provider.
#
# To send real mail in production, set EMAIL_PROVIDER to one of:
#   sendgrid   — SendGrid HTTP API v3 (RECOMMENDED — implemented in Phase Q9)
#   aws_ses    — AWS SES (placeholder)
#   mailgun    — Mailgun HTTP API (placeholder)
#   nodemailer — generic SMTP (placeholder)
#
# For SendGrid:
#   1. Create a SendGrid account + verify sender identity
#   2. Generate an API key with "Mail Send" permission
#   3. Set EMAIL_PROVIDER=sendgrid, EMAIL_API_KEY=SG.xxx, FROM_EMAIL=verified@domain
#
# FROM_EMAIL must be a verified sender on the chosen provider.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=mock_email_api_key
FROM_EMAIL=noreply@azaman.com
FROM_NAME=Azaman Platform

# SMS (phone verification OTP + withdrawal confirmations — Phase L2, real providers Phase Q9)
#
# Default = MOCK. In MOCK mode the server logs each SMS to stdout and returns
# a stub success response — OTP codes are surfaced in API responses in
# non-production for easy testing.
#
# To send real SMS in production, set SMS_PROVIDER to one of:
#   moolre   — Moolre SMS / VAS API (Ghana — uses the MOOLRE_* vars above)
#   arkesel  — Arkesel SMS API v2 (Ghana, implemented in Phase Q9)
#   twilio   — Twilio SMS API (placeholder)
#   aws_sns  — AWS SNS (placeholder)
#   hubtel   — Hubtel (Ghana, placeholder)
#
# For Moolre SMS: set SMS_PROVIDER=moolre and provide MOOLRE_API_USER +
# MOOLRE_VAS_KEY (or MOOLRE_API_KEY) + MOOLRE_SMS_SENDER_ID in the MOOLRE block.
#
# SMS_FORCE_LIVE: by default SMS falls back to MOCK whenever NODE_ENV is not
# 'production', which blocks testing a real provider against its sandbox from a
# dev box. Set SMS_FORCE_LIVE=true to let a non-mock provider actually send in
# dev/staging. No effect when SMS_PROVIDER=mock.
# SMS_FORCE_LIVE=false
#
# For Arkesel:
#   1. Create an Arkesel account (https://arkesel.com)
#   2. Get your API key from the dashboard
#   3. Set SMS_PROVIDER=arkesel, ARKESEL_API_KEY=xxx, ARKESEL_SENDER_ID=AZAMAN
#
# SMS_LARGE_WITHDRAWAL_THRESHOLD controls the USDC amount at or above which
# a fire-and-forget SMS confirmation is sent to users with verified phones.
# Set to 0 to SMS on every withdrawal, or very high to effectively disable.
SMS_PROVIDER=mock
SMS_API_KEY=mock_sms_api_key
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=AZAMAN
SENDGRID_API_KEY=your_sendgrid_api_key
SMS_LARGE_WITHDRAWAL_THRESHOLD=100

# KYC — Dojah Identity Verification (Phase Q6)
#
# Default = MOCK. In MOCK mode the server returns a fake widget URL and accepts
# any webhook payload with signature 'mock_signature' — useful for local dev
# and CI without a real Dojah account.
#
# To enable real verification, set KYC_PROVIDER=LIVE (or dojah) and fill in the
# credentials from your Dojah dashboard (https://app.dojah.io). This binds
# services/dojahKycService.js, which performs synchronous Ghana ID lookups
# (SSNIT / Voter / Driver's Licence / Passport) against the Dojah API.
#
#   KYC_PROVIDER=mock          → services/kycService.js     (deterministic, no network)
#   KYC_PROVIDER=LIVE | dojah  → services/dojahKycService.js (real Dojah calls)
#
# Confidence thresholds control auto-approve/reject:
#   - Score >= KYC_AUTO_APPROVE_THRESHOLD → auto VERIFIED
#   - Score <  KYC_AUTO_REJECT_THRESHOLD  → auto REJECTED
#   - Between thresholds → stays PENDING for admin manual review
#
KYC_PROVIDER=mock

# ── Dojah credentials (Settings → API Keys in the Dojah dashboard) ────────────
# The Dojah LIVE adapter sends these as request headers on every call:
#   AppId:         DOJAH_APP_ID
#   Authorization: DOJAH_PRIVATE_KEY
DOJAH_APP_ID=your_dojah_app_id
DOJAH_PRIVATE_KEY=your_dojah_private_key

# Sandbox base URL for live testing. Switch to https://api.dojah.io for prod.
DOJAH_SANDBOX_BASE_URL=https://sandbox.dojah.io

# ── Legacy / widget-flow credentials (only needed for the async widget path) ──
DOJAH_PUBLIC_KEY=your_dojah_public_key
DOJAH_SECRET_KEY=your_dojah_secret_key
DOJAH_WIDGET_ID=your_dojah_widget_id
DOJAH_WEBHOOK_SECRET=your_dojah_webhook_hmac_secret

KYC_AUTO_APPROVE_THRESHOLD=70
KYC_AUTO_REJECT_THRESHOLD=40

# Autonomous Payouts (Phase Q8)
#
# The PayoutBatchWorker scans PENDING fiat withdrawals on an interval and
# auto-dispatches them via MTN MoMo when conditions are met:
#   1. autoPayoutEnabled = true (master switch, stored in GlobalSettings DB row)
#   2. SystemFiatPool balance >= autoPayoutThresholdUsdc
#   3. Individual withdrawal amount <= autoPayoutMaxAmountUsdc
#
# Withdrawals that fail any gate are flagged as NEEDS_MANUAL_REVIEW for
# admin action in the War Room.
#
# All four values below are DEFAULTS that seed the GlobalSettings row on
# first deploy. After that, admin controls them live via:
#   GET  /api/admin/payouts/settings
#   PUT  /api/admin/payouts/settings
#
# The worker reads from the DB on every tick, so .env changes alone won't
# take effect after first boot — use the admin API instead.
#
# AUTO_PAYOUT_ENABLED=false        # Master switch (DB-controlled after first boot)
# AUTO_PAYOUT_THRESHOLD_USDC=500   # Pool must have at least this much
# AUTO_PAYOUT_MAX_AMOUNT_USDC=200  # Max single withdrawal for auto-dispatch
# AUTO_PAYOUT_INTERVAL_MS=120000   # Scan every 2 minutes

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Enable request logging in production (default: false)
LOG_REQUESTS=false

# Support email shown to banned users
APPEAL_EMAIL=support@azaman.me

# ── ADMIN ALERTS (B-11) ───────────────────────────────────────────────────────
# Where critical operational alerts are emailed (large pending withdrawals, fiat
# pool running low, disputes filed, KYC needing manual review, suspicious trade
# bursts). Alerts also broadcast live to the admin portal via Socket.IO. Email
# delivery is fire-and-forget and only fires once a real EMAIL_PROVIDER is set.
ADMIN_ALERT_EMAIL=ops@azaman.com
# USD amount at/above which a pending withdrawal raises a LARGE_WITHDRAWAL_PENDING
# alert. Default 500.
ADMIN_ALERT_THRESHOLD_USD=500

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────

# BUY-ad code path is currently broken: completing a BUY-ad trade mints
# ~amountCrypto USDC of platform liability with no offsetting debit (vendor
# gains availableBalance + SystemProfitFees gains adminCutUsdc, both out of
# thin air). See docs/PHASE_D_AZM_LEDGER_DESIGN.md §1.5 for the trace.
#
# ── BUY ADS ───────────────────────────────────────────────────────────────────
# Phase F (2026-05-25): BUY ads fully re-enabled. The env-flag gate has been
# removed from the codebase. This variable is no longer read; kept here for
# historical reference only.
# BUY_ADS_ENABLED=1  (no longer checked)

# ── AUTH (Phase K cutover sentinel) ───────────────────────────────────────────

# Phase K (refresh-token + tokenVersion) one-time cutover sentinel. When
# set to "1", the `protect` middleware skips the tokenVersion staleness
# check (USER_GONE / BANNED branches still run unconditionally). This
# exists so pre-Phase-K access tokens with no tokenVersion claim continue
# to work for the 7-day rollout window after deploy. Unset (or 0) in
# steady state — leaving it on weakens the privilege-change cascade.
AUTH_SKIP_TOKEN_VERSION_CHECK=0

# ── SMART ESCROW ENGINE ───────────────────────────────────────────────────────
# Platform fee taken from payer when escrow is funded (upfront, non-refundable).
# 0.005 = 0.5%. Stored in GlobalSettings DB table — this env var is the seed.
SMART_ESCROW_FEE_PCT=0.005
# Hours before an unfunded (DRAFT) escrow auto-expires. Default 24.
ESCROW_DRAFT_EXPIRY_HOURS=24
# Days before a funded but inactive escrow auto-expires. Default 30.
ESCROW_FUNDED_EXPIRY_DAYS=30

# BUSINESS PORTAL (2026-06-16)
# Additional platform fee on each COMPLETED business order (on top of escrow fee).
# 0.0 = disabled. Range [0..0.05] (max 5%).
BUSINESS_ORDER_FEE_PCT=0.0

BUSINESS_INVOICE_FEE_PCT=0.015   # Platform fee on invoice payments (default 1.5%)

# Hours before an AWAITING_PAYMENT order auto-cancels if the customer
# never funds the linked escrow. Default 24.
BUSINESS_ORDER_DRAFT_EXPIRY_HOURS=24
