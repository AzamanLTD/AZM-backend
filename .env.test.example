# .env.test.example — template for running the Jest suite against a real DB.
# Copy to .env.test and fill in, OR export these in your shell / CI service.
#
# math.test.js needs nothing here (pure arithmetic, always runs).
# auth.test.js and trade-flow.test.js activate ONLY when TEST_DATABASE_URL is
# set — point it at a DISPOSABLE database; the suite writes and mutates rows.

# Disposable Postgres for integration tests. NEVER point this at production.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/azaman_test

# Any 32+ char string is fine for tests; only needs to be internally consistent.
JWT_SECRET=test_secret_at_least_32_chars_long_xxxxx

NODE_ENV=test
