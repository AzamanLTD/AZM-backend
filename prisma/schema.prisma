// =============================================================================
// V3: SOCIAL FRIEND SYSTEM — Friendship, Direct Messaging & Peer Transfers
// =============================================================================

model Friendship {
  id          String           @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  message     String? // Intro message sent with friend request

  // Phase UI-5 (2026-05-26): Per-friendship local nicknames. JSON map of
  // `{ "<observerUserId>": "<nickname they set for the other person>" }`.
  // Each side of the friendship can set their own nickname; both are
  // stored in the same map keyed by the OBSERVER's userId.
  localNicknames Json @default("{}")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  directMessages DirectMessage[]
  peerTransfers  PeerTransfer[]
  // Phase UI-4 (2026-05-26): Tickets Engine
  tickets        Ticket[]

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  // Phase I: powers cursor pagination on GET /api/friends.
  // Query: WHERE (requesterId=X OR addresseeId=X) AND status='ACCEPTED'
  //        ORDER BY updatedAt DESC. The OR predicate needs both shapes —
  //        Postgres BitmapOrs them and feeds the merged set into a top-K.
  @@index([requesterId, status, updatedAt(sort: Desc)])
  @@index([addresseeId, status, updatedAt(sort: Desc)])
}

model DirectMessage {
  id           String            @id @default(uuid())
  friendshipId String
  senderId     Int
  receiverId   Int
  content      String
  messageType  DirectMessageType @default(TEXT)
  metadata     Json? // For transfer details (amount, reference, transferId)
  isRead       Boolean           @default(false)

  // Phase UI-3 (2026-05-26): media columns for rich-media chat.
  // Used when messageType is IMAGE, VIDEO, DOCUMENT, AUDIO, or LINK.
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  // Premium chat fields (Telegram-inspired)
  localId           String?
  status            String    @default("sent")
  editedAt          DateTime?
  editedContent     String?
  deletedAt         DateTime?
  reactions         Json      @default("{}")
  forwardedFromId   String?
  forwardedFromUser String?

  // B-1 (2026-06-28): reply-to support
  replyToId         String?
  replyToText       String?
  replyToSenderName String?

  // B-1 (2026-06-28): sticker support
  stickerAssetPath  String?
  stickerIsAnimated Boolean?

  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender     User       @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User       @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([friendshipId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  // Phase I: powers cursor pagination on GET /api/friends/chat/:friendshipId
  // (filter friendshipId, order createdAt desc).
  @@index([friendshipId, createdAt(sort: Desc)])
  @@index([localId])
}

