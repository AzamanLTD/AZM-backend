// =============================================================================
// CORE USER MODEL
// =============================================================================

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String

  // --- V2: THE GREAT ACCOUNT SPLIT — Unified Ledger Balances ---
  // NOTE (Phase J2, 2026-05-25): every Decimal column on this model that
  // represents a balance has a CHECK (col >= 0) constraint at the DB
  // level (see prisma/migrations/20260525_phase_j2_balance_check_constraints).
  // Prisma can't model CHECK constraints in the schema language, so they
  // live in the SQL migration only. completionRate has CHECK (>= 0 AND
  // <= 100). Phase J3 (2026-05-25): Float → Decimal migration complete.
  availableBalance         Decimal @default(0.0) @db.Decimal(20, 8) // USDT available for trading / spending
  vendorUnallocatedBalance Decimal @default(0.0) @db.Decimal(20, 8) // USDT returned to vendor post auto-cancel
  escrowLockedBalance      Decimal @default(0.0) @db.Decimal(20, 8) // USDT locked in escrow for active trades
  disputeEscrowBalance     Decimal @default(0.0) @db.Decimal(20, 8) // USDT frozen during an open dispute

  // --- AZM LOYALTY POINTS (independent reward ledger) ---
  // AZM is an internal platform loyalty-point currency (like BNB or airline
  // miles). It is NOT derived from availableBalance. Users earn AZM through
  // platform activities (trade completions, referrals, achievements) and can
  // spend it on premium features (fee discounts, ad-tier unlocks, etc.).
  // AZM is NOT a blockchain token — it is strictly a backend-controlled
  // database ledger. Phase D-2 incorrectly dropped this column; Phase D-3
  // restores it as an independent loyalty ledger.
  azmBalance Decimal @default(0.0) @db.Decimal(20, 8) // AZM loyalty points (independent of USDC)

  // --- TATUM INTEGRATION ---
  tatumPolygonAddress String?

  // --- V2: INFLUENCER & REFERRAL SYSTEM ---
  influencerCode String? @unique
  referredByCode String?

  // --- AUTH & SECURITY ---
  googleId           String? @unique
  appleId            String? @unique
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean @default(false)
  pinHash            String?
  profilePictureUrl  String?
  isDeleted          Boolean @default(false)

  // --- PHASE K: TOKEN INVALIDATION ---
  // Bumped whenever the user's privileges change (today: USER -> VENDOR via
  // KYC approval). Embedded in the access JWT; `protect` rejects access
  // tokens whose claim < live row. Refresh tokens for the user are
  // cascade-revoked at the same moment so the new privileges propagate
  // exactly once per role change.
  tokenVersion  Int            @default(0)
  refreshTokens RefreshToken[]

  // --- IDENTITY & ROLE ---
  role     Role    @default(USER)
  fcmToken String?

  // --- KYC & LEGAL IDENTITY ---
  kycStatus    KycStatus @default(UNVERIFIED)
  legalName    String?
  idType       String?
  idNumber     String?
  idImageFront String?
  idImageBack  String?

  // --- REPUTATION STATS ---
  tradesCompleted Int     @default(0)
  completionRate  Decimal @default(0.0) @db.Decimal(5, 2)
  positiveReviews Int     @default(0)
  negativeReviews Int     @default(0)

  // --- V2: STRIKE & BAN SYSTEM ---
  strikeCount            Int       @default(0) // V2 unified strike counter
  cancellationAbuseCount Int       @default(0) // Legacy abuse counter (pre-V2)
  banStatus              BanStatus @default(ACTIVE)
  banUntil               DateTime?

  // --- LOYALTY & DISCOUNT ENGINE ---
  loyaltyTier          LoyaltyTier @default(STANDARD)
  activeDiscountCredit Decimal     @default(0.0) @db.Decimal(20, 8)
  discountExpiresAt    DateTime?

  // --- WITHDRAWAL RISK TIER (admin-assignable) ---
  // Controls which withdrawal fee percentage applies to this user.
  // Resolved against GlobalSettings.withdrawalFeeByRiskTier JSON map.
  withdrawalRiskTier String @default("STANDARD") // STANDARD | TRUSTED | HIGH_RISK

  // --- V3: VENDOR GAMIFICATION SYSTEM ---
  vendorXp        Int         @default(0) // Total XP earned
  vendorLevel     VendorLevel @default(BRONZE) // Current vendor tier
  currentStreak   Int         @default(0) // Consecutive active trade days
  longestStreak   Int         @default(0) // All-time best streak
  lastTradeDate   DateTime? // Last date a trade was completed (for streak calc)
  totalVolumeUsdc Decimal     @default(0.0) @db.Decimal(20, 8) // Lifetime trade volume
  totalProfitUsdc Decimal     @default(0.0) @db.Decimal(20, 8) // Lifetime vendor profit earned

  // --- SECURE VENDOR PAYMENT VAULT ---
  paymentDetails Json?

  // --- V3: USER PREFERENCES (cross-device sync) ---
  selectedTheme       String? @default("dark") // Theme ID: dark, mars, saturn, snow, neonTokyo, deepOcean, volcanic, aurora
  customShortcuts     Json? // Array of shortcut IDs in user's preferred order
  settingsPreferences Json? // General settings blob (haptics, sounds, etc.)

  // --- V4: ONBOARDING & PROFILE ENHANCEMENTS ---
  onboardingCompleted Boolean   @default(false) // Whether user finished the onboarding flow
  onboardingStep      Int       @default(0) // Last completed onboarding step (0 = not started)
  displayName         String? // Optional display name (different from username)
  bio                 String? // Short bio for profile
  phoneNumber         String? // Phone number for notifications/MoMo
  phoneVerified       Boolean   @default(false) // True once OTP-verified via smsService (Phase L2)
  country             String?   @default("GH") // Country code
  lastLoginAt         DateTime? // Track last login time
  loginStreak         Int       @default(0) // Consecutive login days

  // ── PHASE 6 / Social & Vouching Evolution (2026-06-01) ──────────────────────
  // Azaman_ID: unique, immutable, shareable public identifier of the form
  // 'AZM-#########' (literal prefix + 9 digits). Distinct from the numeric
  // primary key (never exposed) and from influencerCode. Nullable in the
  // column only so the additive ADD COLUMN is safe on a populated table; the
  // registration hook + idempotent backfill guarantee it is always populated.
  azamanId            String?   @unique
  // Opt-out of phone Contact_Discovery. While false, the user never appears
  // in another user's /users/discover result.
  discoverable        Boolean   @default(true)
  // SHA-256(HMAC) of the verified E.164 phone with a server pepper. Contact
  // discovery matches hash-to-hash so raw address-book numbers are never
  // compared against (or stored as) plaintext. Set on phone verification +
  // backfill; null until the user verifies a phone.
  phoneHash           String?

  // ==========================================================================
  // RELATIONSHIPS
  // ==========================================================================

  // P2P Trading
  ads            Ad[]
  tradesAsBuyer  Trade[] @relation("BuyerRelation")
  tradesAsVendor Trade[] @relation("VendorRelation")

  // Account Split
  tradeAccounts      TradeAccount[]
  payoutDestinations PayoutDestination[]

  // Finance
  withdrawals  Withdrawal[]
  transactions TransactionHistory[]

  // V2: Trade Queue
  queuedTrades TradeQueue[]

  // Social & Communication
  conversations Conversation[] @relation("ConversationParticipants")
  sentMessages  Message[]      @relation("MessageSender")
  contacts      Contact[]      @relation("ContactOwner")
  savedByUsers  Contact[]      @relation("ContactSavedUser")

  // Reviews
  givenReviews    Review[] @relation("GivenReviews")
  receivedReviews Review[] @relation("ReceivedReviews")

  // Misc
  savedWallets       SavedWallet[]
  savedMomoAccounts  SavedMomoAccount[]
  notifications      Notification[]
  earnedBadges       Badge[]             @relation("UserBadges")
  leaderboardRecords LeaderboardRecord[]
  accountFeedbacks   AccountFeedback[]

  // V3: Social Friend System
  sentFriendRequests     Friendship[]    @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]    @relation("FriendshipAddressee")
  sentDirectMessages     DirectMessage[] @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[] @relation("DirectMessageReceiver")
  sentPeerTransfers      PeerTransfer[]  @relation("PeerTransferSender")
  receivedPeerTransfers  PeerTransfer[]  @relation("PeerTransferReceiver")

  // Phase UI-4 (2026-05-26): Tickets Engine
  createdTickets     Ticket[]        @relation("TicketCreator")
  receivedTickets    Ticket[]        @relation("TicketCounterparty")
  sentTicketMessages TicketMessage[] @relation("TicketMessageSender")

  // V3: Vendor Gamification
  adInteractions     AdInteraction[]
  vendorAchievements VendorAchievement[]

  // V3: Savings System
  savingsGoals    SavingsGoal[]
  savingsDeposits SavingsDeposit[]

  // Phase Q12: Rate Alerts
  rateAlerts RateAlert[]

  // Phase Q14: Dispute Resolutions administered
  disputeResolutions DisputeResolution[] @relation("DisputeResolutionAdmin")

  // Phase E1: AZM Reward History
  azmRewardLogs AzmRewardLog[]

  // Phase E2: AZM Spend History
  azmSpendLogs AzmSpendLog[]

  // Phase V: Vendor Applications
  vendorApplications         VendorApplication[]
  reviewedVendorApplications VendorApplication[] @relation("VendorApplicationReviewer")

  // ── MASTER SPRINT (2026-05-27): Vault, Susu, Smart Route, AZM Auction ──
  vaults            Vault[]
  vaultDeposits     VaultDeposit[]
  groupsCreated     GroupChat[]        @relation("GroupChatCreator")
  groupMemberships  GroupMember[]      @relation("GroupMembership")
  sentGroupMessages GroupMessage[]     @relation("GroupMessageSender")
  vouchesGiven      VouchRecord[]      @relation("VouchVoucher")
  vouchesReceived   VouchRecord[]      @relation("VouchInvitee")
  susuMemberships   SusuMember[]       @relation("SusuMembership")
  susuPayoutsWon    SusuCycle[]        @relation("SusuCycleWinner")
  susuContributions SusuContribution[] @relation("SusuContributor")
  smartRoutes       SmartRoute[]
  smartRouteRuns    SmartRouteRun[]    @relation("SmartRouteRunUser")
  azmAuctionBids    AzmAuctionBid[]    @relation("AuctionBidder")

  // ── PRIVATE SUSU ECOSYSTEM (2026-05-31) ────────────────────────────────────
  // Proof of Residency (Req 3) — admin-reviewed residency document with
  // 365-day expiry sweep. Gates Susu participation alongside kycStatus.
  proofOfResidencyUrl             String?
  proofOfResidencyStatus          ProofOfResidencyStatus @default(NOT_SUBMITTED)
  proofOfResidencySubmittedAt     DateTime?
  proofOfResidencyVerifiedAt      DateTime?
  proofOfResidencyRejectionReason String?

  // Trust Rating (Req 7.10) — global counter, initialised to 100, floored at
  // 0. Decremented by 1 on every Voucher_Slash event. Distinct from
  // SusuMember.trustScore which is a per-Susu rotation-ranking metric.
  trustRating Int @default(100)

  // Relations introduced for the new Susu ecosystem tables. The existing
  // vouchesGiven / vouchesReceived / susuMemberships / susuPayoutsWon /
  // susuContributions relations above remain unchanged.
  susuInvitesSent      SusuInvite[]               @relation("SusuInviteInviter")
  susuInvitesReceived  SusuInvite[]               @relation("SusuInviteInvitee")
  liabilityAcceptances LiabilityAcceptance[]
  publishedContracts   LiabilityContractVersion[] @relation("ContractPublisher")
  vouchSlashesIssued   VoucherSlashLog[]          @relation("SlashVoucher")
  vouchSlashesReceived VoucherSlashLog[]          @relation("SlashVouched")
  acknowledgedAlerts   AdminWarRoomAlert[]        @relation("AlertAcknowledger")

  // PHASE 6: Group join-request proposals (as proposer / as target).
  groupJoinRequestsProposed GroupJoinRequest[] @relation("GJRProposer")
  groupJoinRequestsReceived GroupJoinRequest[] @relation("GJRTarget")

  // PHASE 6 / Phase 4: Liability acceptances where this user vouched for another.
  vouchedLiabilityAcceptances LiabilityAcceptance[] @relation("LiabilityVoucher")

  createdAt DateTime @default(now())
}

// =============================================================================
// PHASE K — REFRESH TOKENS
// =============================================================================
//
// Long-lived refresh tokens. Each row is a UUID, opaque on the wire. The
// /api/auth/refresh endpoint exchanges a valid refresh token for a fresh
// 15-minute access JWT and rotates the refresh token (creates a new row
// with a new id, marks the old one revoked). Logout marks revokedAt.
//
// Privilege changes (e.g., USER -> VENDOR via KYC approval) bump
// User.tokenVersion AND mark every refresh token for that user as revoked,
// forcing the next /refresh to re-issue with the new claims.
//
// A periodic worker can sweep WHERE expiresAt < now AND revokedAt IS NULL
// to keep the table compact.
// =============================================================================
model RefreshToken {
  id        String    @id // UUID — also the on-wire token value
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// P2P TRADING CORE
// =============================================================================

model Ad {
  id     Int    @id @default(autoincrement())
  type   String // "BUY" or "SELL"
  crypto String @default("USDT")

  // Price Settings
  pricePerUSD  Decimal  @db.Decimal(18, 8)
  margin       Decimal? @db.Decimal(10, 4)
  baseMargin   Decimal  @default(0.0) @db.Decimal(10, 4)
  vendorMargin Decimal  @default(0.0) @db.Decimal(10, 4)
  minLimit     Decimal  @db.Decimal(20, 8)
  maxLimit     Decimal  @db.Decimal(20, 8)

  // Payment Config
  paymentMethod String
  terms         String?
  status        String  @default("ACTIVE")

  // Time & Concurrency
  maxPaymentWindow    Int    @default(15)
  activeHoursStart    String @default("08:00")
  activeHoursEnd      String @default("22:00")
  maxConcurrentTrades Int    @default(5) // V2: overflow → TradeQueue

  // Phase E2: Ad Boost (AZM spend feature)
  isBoosted      Boolean   @default(false) // Currently boosted for featured placement
  boostExpiresAt DateTime? // When the boost expires (null = not boosted)

  // Phase F2: Link to vendor's specific payment account
  tradeAccountId String?
  tradeAccount   TradeAccount? @relation(fields: [tradeAccountId], references: [id], onDelete: SetNull)

  // Relations
  vendorId Int
  vendor   User @relation(fields: [vendorId], references: [id])

  // V2: Queue for overflow buyers
  queue TradeQueue[]

  // V3: Ad Interaction Analytics
  interactions AdInteraction[]

  // Master Sprint (2026-05-27): AZM Auction bids targeting this ad
  auctionBids AzmAuctionBid[] @relation("AuctionAd")

  // Phase Q4: Soft-delete archive timestamp (null = active, set = archived)
  archivedAt DateTime?

  createdAt DateTime @default(now())

  // Phase I: powers cursor pagination on GET /api/ads (marketplace).
  // Most queries filter by status='ACTIVE' and order by createdAt desc.
  @@index([status, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
  // Phase E2: boost sorting — boosted ads appear first in marketplace
  @@index([isBoosted(sort: Desc), status, createdAt(sort: Desc)])
}

model Trade {
  id Int @id @default(autoincrement())

  // Transaction Details
  crypto        String
  amountCrypto  Decimal @db.Decimal(20, 8)
  amountFiat    Decimal @db.Decimal(20, 8)
  currency      String  @default("GHS")
  type          String
  rate          Decimal @default(0.0) @db.Decimal(18, 8)
  paymentMethod String  @default("Bank Transfer")

  // Status & Proof
  status      TradeStatus @default(PENDING_PAYMENT)
  proofUrl    String?
  paidAt      DateTime?
  completedAt DateTime?

  // Time Limit & Strike System
  selectedTimeframe Int      @default(15)
  tradeStartTime    DateTime @default(now())
  expiresAt         DateTime
  senderFiatName    String?

  // Milestone Warning Tracking
  milestone33Sent Boolean @default(false)
  milestone66Sent Boolean @default(false)
  milestone99Sent Boolean @default(false)

  // Admin Bonus Tracking
  adminBonusAmount  Decimal @default(0.0) @db.Decimal(20, 8)
  adminBonusMessage String?
  vendorProfitCut   Decimal @default(0.0) @db.Decimal(20, 8)

  // Snapshot of Vendor payment details at trade time
  vendorPaymentDetails Json?

  // Phase F2: Buyer provides their recipient details (SELL ads only)
  buyerPaymentDetails Json?

  // Relationships
  userId   Int
  user     User @relation("BuyerRelation", fields: [userId], references: [id])
  vendorId Int
  vendor   User @relation("VendorRelation", fields: [vendorId], references: [id])

  messages Message[] @relation("TradeMessages")
  reviews  Review[]

  // Phase Q14: Dispute resolution record (one-to-one)
  disputeResolution DisputeResolution?

  createdAt DateTime @default(now())

  // Phase I: powers cursor pagination on GET /api/trades/history.
  // The where clause is `OR: [{userId}, {vendorId}]`, so we need both
  // composite shapes — Postgres can't satisfy an OR from a single index.
  @@index([userId, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
}

// =============================================================================
// V2: TRADE QUEUE (Overflow Management)
// =============================================================================

model TradeQueue {
  id       String           @id @default(uuid())
  buyerId  Int // FK → User
  adId     Int // FK → Ad
  status   TradeQueueStatus @default(WAITING)
  joinedAt DateTime         @default(now())

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  ad    Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([adId])
  @@index([status])
}

// =============================================================================
// ACCOUNT SPLIT: TRADE ACCOUNTS & PAYOUT DESTINATIONS
// =============================================================================

model TradeAccount {
  id                      String                  @id @default(uuid())
  userId                  Int
  methodType              String // e.g., "ZELLE", "CASHAPP", "VENMO", "PAYPAL", "APPLE_PAY", etc.
  accountDetails          Json // Type-specific fields validated by tradeAccountValidation service
  verificationScreenshot  String // URL to uploaded proof screenshot
  adminVerificationStatus AdminVerificationStatus @default(PENDING)
  riskLevel               RiskLevel               @default(MEDIUM)

  // Phase Q2: Soft-delete archive (vendor wallet is NEVER hard-deleted)
  archivedAt    DateTime? // null = active, set = archived (soft-deleted)
  archiveReason String? // "USER_DELETED" | "ADMIN_SUSPENDED" | "COMPLIANCE_HOLD"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ads  Ad[] // Phase F2: ads linked to this account

  @@index([userId])
  @@index([userId, archivedAt])
}

model PayoutDestination {
  id                 String   @id @default(uuid())
  userId             Int
  nickname           String
  destinationType    String // "BINANCE_PAY", "TRC20", "ERC20", "MOMO", etc.
  destinationAddress String
  isExternalCrypto   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// DUAL-ENVIRONMENT CHAT
// =============================================================================

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  tradeId   String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants User[]    @relation("ConversationParticipants")
  messages     Message[]

  @@index([type])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       Int?
  tradeId        Int?
  messageType    MessageType @default(TEXT)
  content        String
  createdAt      DateTime    @default(now())

  // Phase UI-3 (2026-05-26): media columns for rich-media chat.
  // Used when messageType is IMAGE, VIDEO, DOCUMENT, AUDIO, or LINK.
  mediaUrl           String?
  mediaType          String? // image | video | document | audio
  mediaMimeType      String?
  mediaSize          Int? // bytes
  mediaDuration      Int? // seconds, audio/video only
  mediaWaveformPeaks Json? // 50-bucket integer array, audio only
  linkPreview        Json? // { url, title, description, image, favicon, fetchedAt }

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id])
  trade        Trade?       @relation("TradeMessages", fields: [tradeId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([tradeId])
  // Phase I: powers cursor pagination on GET /api/chat/:tradeId
  // (filter conversationId, order createdAt desc).
  @@index([conversationId, createdAt(sort: Desc)])
}

model Contact {
  id          String   @id @default(uuid())
  userId      Int
  savedUserId Int
  nickname    String?
  createdAt   DateTime @default(now())

  user      User @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  savedUser User @relation("ContactSavedUser", fields: [savedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, savedUserId])
  @@index([userId])
}

// =============================================================================
// FINANCE: WITHDRAWALS, REVIEWS, SETTINGS
// =============================================================================

model Withdrawal {
  id             Int      @id @default(autoincrement())
  amount         Decimal  @db.Decimal(20, 8)
  payoutMethod   String   @default("BINANCE_ID")
  network        String?
  destination    String   @default("OLD_RECORD")
  totalGasFee    Decimal  @default(0.0) @db.Decimal(20, 8)
  vendorGasShare Decimal  @default(0.0) @db.Decimal(20, 8)
  adminGasShare  Decimal  @default(0.0) @db.Decimal(20, 8)
  status         String   @default("PENDING")
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id         Int      @id @default(autoincrement())
  isPositive Boolean
  comment    String?
  tradeId    Int
  trade      Trade    @relation(fields: [tradeId], references: [id])
  reviewerId Int
  reviewer   User     @relation("GivenReviews", fields: [reviewerId], references: [id])
  revieweeId Int
  reviewee   User     @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([tradeId, reviewerId])
}

model GlobalSettings {
  id Int @id @default(1)

  // Admin Margins (as decimal percentages: 0.03 = 3%)
  bankMargin       Decimal @default(0.03) @db.Decimal(10, 4)
  thirdPartyMargin Decimal @default(0.02) @db.Decimal(10, 4)

  // Vendor Profit Share
  vendorShareUnder1k Decimal @default(0.40) @db.Decimal(10, 4)
  vendorShareOver1k  Decimal @default(0.50) @db.Decimal(10, 4)

  // Tier Threshold — trades at or above this USD amount use the "over" split
  tierThreshold Decimal @default(1000.0) @db.Decimal(20, 8)

  // Vendor minimum collateral — minimum trading pool balance required to post an ad
  vendorMinCollateral Decimal @default(500.0) @db.Decimal(20, 8)

  // Gas Fee Estimates (USD)
  gasFeeTrc20 Decimal @default(1.00) @db.Decimal(20, 8)
  gasFeeErc20 Decimal @default(5.00) @db.Decimal(20, 8)
  gasFeeBep20 Decimal @default(0.30) @db.Decimal(20, 8)

  // Live Oracle Rates  (legacy single rate — kept synced with liveRetailRate)
  liveUsdToGhs  Decimal @default(12.50) @db.Decimal(18, 8)
  liveUsdtToUsd Decimal @default(1.00) @db.Decimal(18, 8)
  liveUsdcToUsd Decimal @default(1.00) @db.Decimal(18, 8)
  liveDaiToUsd  Decimal @default(1.00) @db.Decimal(18, 8)

  // Phase B: Kotani Pay V3 dual-rate model
  //   liveRetailRate    → user UI Hologram (sell USDC → GHS)
  //   liveCorporateRate → admin spread / OTC buy (USDC ← GHS at discount)
  //   liveRateSource    → 'MOCK' | 'LIVE' | 'ORACLE'  (provenance flag)
  //   lastRateSync      → wall-clock of the most recent gateway pull
  liveRetailRate    Decimal   @default(12.50) @db.Decimal(18, 8)
  liveCorporateRate Decimal   @default(12.30) @db.Decimal(18, 8)
  liveRateSource    String    @default("MOCK")
  lastRateSync      DateTime?

  // Phase F2: P2P flat fee (replaces GHS margin math for P2P trades)
  p2pFeePct Decimal @default(0.02) @db.Decimal(10, 4) // 2% default; range [0..1]

  // Withdrawal & Exit Fees (dynamic — admin-configurable)
  baseExitFeePct         Decimal @default(0.02) @db.Decimal(10, 4) // 2% exit fee on fiat withdrawals
  fiatWithdrawalFeePct   Decimal @default(0.02) @db.Decimal(10, 4) // Fiat withdrawal fee (MTN MoMo)
  cryptoWithdrawalFeePct Decimal @default(0.01) @db.Decimal(10, 4) // Crypto gas fee estimate as %
  cryptoPlatformFeePct   Decimal @default(0.00) @db.Decimal(10, 4) // Additional platform fee on crypto withdrawals

  // Risk-tier withdrawal fee overrides (JSON map: { "STANDARD": 0.02, "TRUSTED": 0.005, "HIGH_RISK": 0.05 })
  withdrawalFeeByRiskTier Json @default("{\"STANDARD\":0.02,\"TRUSTED\":0.005,\"HIGH_RISK\":0.05}")

  // Per-payment-method P2P fee rates (JSON map: method → fee decimal)
  // Admin-configurable from the Fee Engine. p2pFeePct is the fallback for unlisted methods.
  feeByPaymentMethod Json @default("{\"ZELLE\":0.02,\"CASHAPP\":0.02,\"APPLE_PAY\":0.025,\"GOOGLE_PAY\":0.025,\"VENMO\":0.025,\"PAYPAL\":0.04,\"WISE\":0.02,\"REVOLUT\":0.025,\"WESTERN_UNION\":0.015,\"WIRE_TRANSFER\":0.015}")

  // Supported payment methods configuration (JSON array of method definitions)
  // Each entry: { key, label, riskLevel, requiredFields: [{ name, label, type, placeholder }] }
  supportedPaymentMethods Json @default("[{\"key\":\"ZELLE\",\"label\":\"Zelle\",\"riskLevel\":\"LOW\",\"requiredFields\":[{\"name\":\"email\",\"label\":\"Zelle Email\",\"type\":\"email\",\"placeholder\":\"you@email.com\"},{\"name\":\"phone\",\"label\":\"Phone (optional)\",\"type\":\"phone\",\"placeholder\":\"+1234567890\"}]},{\"key\":\"CASHAPP\",\"label\":\"CashApp\",\"riskLevel\":\"LOW\",\"requiredFields\":[{\"name\":\"cashtag\",\"label\":\"$Cashtag\",\"type\":\"text\",\"placeholder\":\"$YourTag\"}]},{\"key\":\"APPLE_PAY\",\"label\":\"Apple Pay\",\"riskLevel\":\"MEDIUM\",\"requiredFields\":[{\"name\":\"phone\",\"label\":\"Phone Number\",\"type\":\"phone\",\"placeholder\":\"+1234567890\"}]},{\"key\":\"GOOGLE_PAY\",\"label\":\"Google Pay\",\"riskLevel\":\"MEDIUM\",\"requiredFields\":[{\"name\":\"email\",\"label\":\"Google Pay Email\",\"type\":\"email\",\"placeholder\":\"you@gmail.com\"}]},{\"key\":\"VENMO\",\"label\":\"Venmo\",\"riskLevel\":\"MEDIUM\",\"requiredFields\":[{\"name\":\"username\",\"label\":\"Venmo Username\",\"type\":\"text\",\"placeholder\":\"@YourVenmo\"}]},{\"key\":\"PAYPAL\",\"label\":\"PayPal\",\"riskLevel\":\"HIGH\",\"requiredFields\":[{\"name\":\"email\",\"label\":\"PayPal Email\",\"type\":\"email\",\"placeholder\":\"you@email.com\"}]},{\"key\":\"WISE\",\"label\":\"Wise\",\"riskLevel\":\"LOW\",\"requiredFields\":[{\"name\":\"email\",\"label\":\"Wise Email\",\"type\":\"email\",\"placeholder\":\"you@email.com\"},{\"name\":\"accountTag\",\"label\":\"Account Tag\",\"type\":\"text\",\"placeholder\":\"@yourtag\"}]},{\"key\":\"REVOLUT\",\"label\":\"Revolut\",\"riskLevel\":\"MEDIUM\",\"requiredFields\":[{\"name\":\"username\",\"label\":\"Revolut Tag\",\"type\":\"text\",\"placeholder\":\"@yourtag\"},{\"name\":\"phone\",\"label\":\"Phone\",\"type\":\"phone\",\"placeholder\":\"+1234567890\"}]},{\"key\":\"WESTERN_UNION\",\"label\":\"Western Union\",\"riskLevel\":\"LOW\",\"requiredFields\":[{\"name\":\"fullName\",\"label\":\"Receiver Full Name\",\"type\":\"text\",\"placeholder\":\"John Doe\"},{\"name\":\"country\",\"label\":\"Country\",\"type\":\"text\",\"placeholder\":\"US\"}]},{\"key\":\"WIRE_TRANSFER\",\"label\":\"Wire Transfer\",\"riskLevel\":\"LOW\",\"requiredFields\":[{\"name\":\"bankName\",\"label\":\"Bank Name\",\"type\":\"text\",\"placeholder\":\"Chase Bank\"},{\"name\":\"accountNumber\",\"label\":\"Account Number\",\"type\":\"text\",\"placeholder\":\"1234567890\"},{\"name\":\"routingNumber\",\"label\":\"Routing Number\",\"type\":\"text\",\"placeholder\":\"021000021\"}]}]")

  // Phase Q8: Autonomous Payout Configuration
  autoPayoutEnabled       Boolean @default(false) // Master switch
  autoPayoutThresholdUsdc Decimal @default(500.00) @db.Decimal(20, 8) // Pool must have >= this
  autoPayoutMaxAmountUsdc Decimal @default(200.00) @db.Decimal(20, 8) // Max single withdrawal for auto
  autoPayoutIntervalMs    Int     @default(120000) // Worker scan interval (ms)

  // Phase Q15: App Version Gate
  minAppVersion  String @default("1.0.0") // Minimum supported app version (semver)
  forceUpdateUrl String @default("https://play.google.com/store/apps/details?id=com.azaman.app")
  updateMessage  String @default("A new version of Azaman is available. Please update to continue.")

  // PHASE 6 / Phase 5: Susu Profit Engine — platform fee on Susu cycle payouts
  // Default 3% (0.03). Admin-configurable via /api/admin/settings. Fee is
  // deducted from the pooled contribution before payout: takeHome = pooled - fee.
  // Range [0, 1]. Persisted per cycle in SusuCycle.feeUsdc for audit.
  susuProfitPct Decimal @default(0.03) @db.Decimal(10, 4)

  updatedAt DateTime @updatedAt
}

// =============================================================================
// ADMIN FEE PROFILES — Dynamic Fee Override System
//
// Allows the admin to create scoped fee rules that override GlobalSettings
// defaults. Resolution priority: highest `priority` value wins. Scopes:
//   ALL              — matches every trade (global override)
//   VENDOR_TIER      — matches vendors at or above a tier (targetValue = tier name)
//   USER_TIER        — matches buyers with >= N completed trades (targetValue = N)
//   INFLUENCER_REFERRAL — matches buyers referred by a specific code (targetValue = code)
//   HOLIDAY          — matches all trades within validFrom..validUntil window
//   CUSTOM           — matches specific user IDs (targetValue = comma-separated IDs)
// =============================================================================
model AdminFeeProfile {
  id          String  @id @default(uuid())
  name        String
  targetScope String // ALL | VENDOR_TIER | USER_TIER | INFLUENCER_REFERRAL | HOLIDAY | CUSTOM
  targetValue String? // Scope-specific filter value

  // Fee parameters (all as decimals 0..1)
  platformFeePct Decimal @db.Decimal(10, 4) // Platform fee % on trade amount
  adminSplitPct  Decimal @db.Decimal(10, 4) // Admin's share of the platform fee
  vendorSplitPct Decimal @db.Decimal(10, 4) // Vendor's share of the platform fee
  exitFeePct     Decimal @db.Decimal(10, 4) // Exit/withdrawal fee override

  // Priority & scheduling
  priority   Int       @default(0) // Higher = checked first
  isActive   Boolean   @default(true)
  validFrom  DateTime? // null = immediately active
  validUntil DateTime? // null = never expires

  // Audit
  createdBy Int? // Admin user ID who created this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority(sort: Desc)])
}

// =============================================================================
// ADMIN SETTINGS AUDIT LOG — Tracks every financial parameter change
// =============================================================================
model AdminSettingsAuditLog {
  id         String   @id @default(uuid())
  adminId    Int // Who made the change
  adminName  String? // Username snapshot for display
  action     String // 'UPDATE_SETTINGS' | 'CREATE_FEE_PROFILE' | 'UPDATE_FEE_PROFILE' | etc.
  targetType String // 'GLOBAL_SETTINGS' | 'FEE_PROFILE' | 'USER_RISK_TIER'
  targetId   String? // ID of the affected record (if applicable)
  changes    Json // { field: { old: X, new: Y }, ... }
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt(sort: Desc)])
}

model SavedWallet {
  id              Int       @id @default(autoincrement())
  label           String
  address         String
  network         String
  provider        String    @default("PENDING")
  riskLevel       RiskLevel @default(LOW)
  accountName     String?
  secondaryDetail String?
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
}

model Notification {
  id            String               @id @default(uuid())
  userId        Int
  title         String
  body          String
  category      NotificationCategory
  isRead        Boolean              @default(false)
  actionPayload Json
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Phase I: composite indexes powering cursor pagination on
  //   GET /api/notifications            (filter userId, order createdAt desc)
  //   GET /api/notifications/unread     (filter userId+isRead, order createdAt desc)
  // Postgres uses the leftmost-prefix rule, so the bare [userId] index above
  // could be dropped in a future cleanup — kept for now for backwards-compat
  // with any ad-hoc admin queries.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
}

