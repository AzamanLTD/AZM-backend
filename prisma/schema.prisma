// =============================================================================
// SMART ESCROW ENGINE & BUSINESS ACCOUNTS (2026-06-14)
//
// ESCROW-type Tickets become real USDC escrow via the SmartEscrow model.
// Businesses register a BusinessProfile with a searchable BIZ-XXXXXXXXX id and
// transact in "business-mode" tickets (no friendship required). Disputes
// escalate through EscrowDispute with admin/worker assignment and rulings.
//
// Funds convention (shared with the P2P flow but entirely separate code):
//   FUND    payer.availableBalance      -> payer.escrowLockedBalance (+ fee to SystemProfitFees)
//   RELEASE payer.escrowLockedBalance   -> payee.availableBalance
//   DISPUTE payer.escrowLockedBalance   -> payer.disputeEscrowBalance
//   REFUND  payer.{escrowLocked|disputeEscrow}Balance -> payer.availableBalance
// =============================================================================

enum EscrowStatus {
  DRAFT // created, not yet funded by payer
  FUNDED // payer has locked funds — escrow is live
  IN_PROGRESS // both parties explicitly acknowledged readiness
  PENDING_SETTLEMENT // one party marked satisfied, awaiting the other
  SETTLED // both marked satisfied — auto-released to payee
  DISPUTED // one party raised a formal dispute
  ADMIN_REVIEW // escalated and assigned to an admin/worker
  RELEASED // admin ruled for payee — funds transferred
  REFUNDED // admin ruled for payer — funds returned
  EXPIRED // unfunded (24h) or inactive (30d) — auto-cancelled
}

enum DisputeStatus {
  PENDING // raised, not yet assigned to any admin/worker
  ASSIGNED // assigned to a specific admin/worker
  UNDER_REVIEW // actively being reviewed
  RESOLVED // ruling has been issued
}

enum DisputeRuling {
  FULL_RELEASE // 100% to payee
  FULL_REFUND // 100% to payer
  SPLIT // custom split defined by payerPct + payeePct
}

