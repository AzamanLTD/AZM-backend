// =============================================================================
// SAVED MOMO ACCOUNTS  (Master Sprint v2, 2026-05-27)
//
// Local-fiat deposit destinations the user pre-saves so the deposit screen
// can fire a STK-push prompt to a known/verified phone number with one tap.
// We never collect "payment" inputs at deposit time — the gateway sends the
// prompt to the saved phone, the user approves it on their phone, and the
// webhook credits availableBalance once the gateway confirms settlement.
//
// Save-time security:
//   • Backend re-verifies the user's password (or 2FA token) before persisting.
//   • Provider name lookup (mocked until Kotani Pay V3 ships the endpoint —
//     the field then just gets re-populated at first use).
// =============================================================================

model SavedMomoAccount {
  id          String    @id @default(uuid())
  userId      Int
  nickname    String    @db.VarChar(40) // user-chosen label e.g. "Mum's MTN"
  provider    String // MTN | VODAFONE | TELECEL
  phoneNumber String // E.164 string, unique per user+number
  accountName String? // resolved via provider lookup
  isVerified  Boolean   @default(false) // true once provider returns a name
  isPrimary   Boolean   @default(false) // user can mark one as default
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
  @@index([userId])
}

