// =============================================================================
// PHASE E1: AZM REWARD LOG — Tracks every AZM credit event
// Every time a user earns AZM (trade completion, login streak, referral,
// achievement unlock, etc.), a row is written here. Provides a transparent
// audit trail for the loyalty-point system and powers the "AZM History"
// screen in the frontend.
// =============================================================================

model AzmRewardLog {
  id           String   @id @default(uuid())
  userId       Int
  amount       Decimal  @db.Decimal(20, 8) // AZM credited (always positive — debits are a future Phase E2 concern)
  reason       String // Human-readable description
  source       String // Machine key: TRADE_COMPLETE, LOGIN_STREAK, REFERRAL_BONUS, ACHIEVEMENT_UNLOCK, MILESTONE
  metadata     Json? // Optional context (tradeId, streak count, achievement name, etc.)
  balanceAfter Decimal  @default(0.0) @db.Decimal(20, 8) // User's azmBalance after this credit
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([source])
  @@index([userId, source])
}

// =============================================================================
// PHASE E2: AZM SPEND LOG — Tracks every AZM debit event
// Every time a user spends AZM (fee discounts, ad boosts, etc.), a row is
// written here. Provides a transparent audit trail for the loyalty-point
// spend side and powers the "AZM Spend History" in the frontend.
// =============================================================================

model AzmSpendLog {
  id           String   @id @default(uuid())
  userId       Int
  amount       Decimal  @db.Decimal(20, 8) // AZM debited (always positive — the direction is implied by the table)
  reason       String // Human-readable description
  source       String // Machine key: FEE_DISCOUNT, AD_BOOST
  metadata     Json? // Optional context (tierId, adId, discount percentage, etc.)
  balanceAfter Decimal  @default(0.0) @db.Decimal(20, 8) // User's azmBalance after this debit
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([source])
  @@index([userId, source])
}

// =============================================================================
// V3: SAVINGS SYSTEM — Goal-Based Savings with Gamification
// Users set savings targets with scheduled deposits. Funds are locked until
// the goal end date. Early withdrawal incurs a penalty. Streaks reward
// consistency.
// =============================================================================

model SavingsGoal {
  id                     String    @id @default(uuid())
  userId                 Int
  name                   String    @default("My Savings")
  targetAmountGhs        Decimal   @db.Decimal(20, 8) // Total target in GHS
  currentAmountGhs       Decimal   @default(0.0) @db.Decimal(20, 8) // Progress so far (GHS equivalent)
  frequencyAmount        Decimal   @db.Decimal(20, 8) // Amount per scheduled deposit (GHS)
  frequency              String    @default("WEEKLY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY
  startDate              DateTime  @default(now())
  endDate                DateTime? // When the goal matures (null = open-ended)
  nextDueDate            DateTime? // Next scheduled deposit date
  status                 String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED, CANCELLED
  streakCount            Int       @default(0) // Consecutive on-time deposits
  longestStreak          Int       @default(0)
  missedCount            Int       @default(0) // Times the user missed a deposit
  totalDeposits          Int       @default(0) // Count of successful deposits
  isLocked               Boolean   @default(true) // Whether early withdrawal is penalized
  earlyWithdrawalPenalty Decimal   @default(0.02) @db.Decimal(10, 4) // 2% penalty for breaking lock

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits SavingsDeposit[]

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([nextDueDate])
}

model SavingsDeposit {
  id         String  @id @default(uuid())
  goalId     String
  userId     Int
  amountGhs  Decimal @db.Decimal(20, 8) // Amount deposited in GHS
  amountUsdc Decimal @db.Decimal(20, 8) // USDC equivalent at time of deposit
  type       String  @default("SCHEDULED") // SCHEDULED, MANUAL, BONUS
  status     String  @default("COMPLETED") // COMPLETED, FAILED, PENDING

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([goalId, createdAt(sort: Desc)])
}

// =============================================================================
// PHASE Q1: ADMIN FEE PROFILES — Dynamic Margin/Split Control
//
// The admin can create fee profiles that override the default platform fee
// percentages and admin/vendor split ratios. Profiles target specific scopes
// (all users, vendor tiers, influencer referrals, holiday promos) and have
// optional time windows. The highest-priority matching profile wins.
//
// Resolution logic (in services/feeProfileService.js):
//   1. Find active profiles where validFrom <= now <= validUntil (or null)
//   2. Filter to those matching the trade context (user referral, vendor tier, ALL)
//   3. Pick highest priority
// =============================================================================
// PHASE Q12: RATE ALERT SYSTEM
//
// Users set price alerts ("Notify me when USD/GHS crosses X").
// The oracle service checks all active, un-triggered alerts on each rate sync.
// When a threshold is crossed, the alert is marked triggered and a notification
// is sent via notificationService.
// =============================================================================

model RateAlert {
  id            String    @id @default(uuid())
  userId        Int
  targetRate    Decimal   @db.Decimal(18, 8) // The rate threshold
  direction     String    @default("ABOVE") // ABOVE | BELOW
  ratePair      String    @default("USD_GHS") // Which rate pair to watch
  isTriggered   Boolean   @default(false)
  triggeredAt   DateTime?
  triggeredRate Decimal?  @db.Decimal(18, 8) // The rate when alert fired
  isActive      Boolean   @default(true)
  note          String? // User's optional label

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([isActive, isTriggered, direction, targetRate])
  @@index([userId, createdAt(sort: Desc)])
}

// =============================================================================
// PHASE Q14: DISPUTE RESOLUTION — Structured Admin Workflow
//
// When a trade enters DISPUTED status, an admin can resolve it via:
//   1. Assign (auto or manual)
//   2. Review (chat history, proofs, user stats)
//   3. Rule (BUYER_WINS, VENDOR_WINS, SPLIT)
//   4. Auto-execute (escrow release, notifications, stats update)
// =============================================================================

model DisputeResolution {
  id           String    @id @default(uuid())
  tradeId      Int       @unique // One resolution per trade
  adminId      Int // Admin who resolved
  ruling       String // BUYER_WINS | VENDOR_WINS | SPLIT
  reason       String // Admin's explanation (required)
  buyerAmount  Decimal   @default(0) @db.Decimal(20, 8) // USDC credited to buyer
  vendorAmount Decimal   @default(0) @db.Decimal(20, 8) // USDC credited to vendor
  totalEscrow  Decimal   @db.Decimal(20, 8) // Total escrow at resolution time
  status       String    @default("PENDING") // PENDING | EXECUTED | FAILED
  executedAt   DateTime?

  trade Trade @relation(fields: [tradeId], references: [id])
  admin User  @relation("DisputeResolutionAdmin", fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PHASE V: VENDOR APPLICATION — Binance-Level Merchant Registration
//
// Users submit comprehensive KYC + financial information to become vendors.
// Admin reviews in the War Room → APPROVED triggers role change USER → VENDOR.
// =============================================================================

enum VendorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SourceOfFunds {
  EMPLOYMENT
  BUSINESS
  INVESTMENTS
  SAVINGS
  OTHER
}

enum MonthlyVolumeEstimate {
  TIER_1 // $0 – $1,000
  TIER_2 // $1,000 – $5,000
  TIER_3 // $5,000 – $20,000
  TIER_4 // $20,000+
}

model VendorApplication {
  id     String                  @id @default(uuid())
  userId Int
  status VendorApplicationStatus @default(PENDING)

  // Step 1: Personal Identity
  legalName    String
  dateOfBirth  String
  country      String
  idType       String // NATIONAL_ID | PASSPORT | DRIVERS_LICENSE
  idImageFront String? // URL after upload
  idImageBack  String? // URL (optional)
  selfieWithId String? // URL after upload

  // Step 2: Proof of Address
  proofOfAddress String? // URL after upload
  addressStreet  String
  addressCity    String
  addressRegion  String
  addressPostal  String?

  // Step 3: Financial Background
  sourceOfFunds         SourceOfFunds         @default(EMPLOYMENT)
  sourceOfFundsOther    String? // Free text if OTHER
  monthlyVolumeEstimate MonthlyVolumeEstimate @default(TIER_1)
  hasPreviousExperience Boolean               @default(false)
  previousPlatforms     String? // Comma-separated platform names

  // Step 4: Payment Methods (stored as JSON array)
  paymentMethods Json @default("[]")

  // Step 5: Terms & Collateral
  acceptedTerms    Boolean @default(false)
  collateralAmount Decimal @default(500) @db.Decimal(20, 8)

  // Admin Review
  reviewedBy      Int? // Admin user ID
  reviewedAt      DateTime?
  rejectionReason String?
  adminNotes      String?

  // Relations
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VendorApplicationReviewer", fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([reviewedBy])
}

// =============================================================================
// LINK PREVIEW CACHE (Phase UI-3, 2026-05-26)
//
// Caches Open Graph metadata fetched server-side so:
//   • Clients never deal with CORS/network issues fetching arbitrary URLs.
//   • Two users sharing the same link don't hit the origin twice.
//   • The 24h TTL is enforced via the `expiresAt` column read in the
//     linkPreviewService — entries past their expiry are re-fetched.
// =============================================================================
model LinkPreviewCache {
  id          String   @id @default(uuid())
  urlHash     String   @unique // sha256 of normalised URL — index target
  url         String // original URL (for debugging / re-fetch)
  title       String?
  description String?  @db.Text
  image       String? // primary OG image URL
  favicon     String?
  siteName    String?
  status      String   @default("OK") // OK | FAILED | TIMEOUT | BLOCKED
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([urlHash])
  @@index([expiresAt])
}

// =============================================================================
// TICKETS ENGINE (Phase UI-4, 2026-05-26)
//
// Tickets are isolated, trackable chat workspaces generated INSIDE an
// existing peer-to-peer friendship to record a specific business deal,
// transaction, or agreement. They are NOT escrow-backed P2P trades —
// those remain the formal `Trade` flow with `escrowLockedBalance`. Tickets
// are lightweight social-transactional records that two friends create
// to track an off-platform deal, service swap, or escrow arrangement
// they're negotiating.
//
// Ticket lifecycle:
//   OPEN      — newly created, both parties can post messages
//   CLOSED    — parties marked the deal complete (immutable thereafter)
//   CANCELLED — parties abandoned the negotiation (immutable thereafter)
//
// On creation, a TICKET_LINK DirectMessage is injected into the parent
// friendship chat so both parties see the event card in their main feed
// and can deep-link into the ticket workspace.
// =============================================================================

enum TicketType {
  BUY
  SELL
  ESCROW
  SERVICE_SWAP
}

enum TicketStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Ticket {
  id             String       @id @default(uuid())
  friendshipId   String? // null for business-mode tickets
  creatorId      Int
  counterpartyId Int
  name           String       @db.VarChar(80)
  type           TicketType
  targetAmount   Decimal      @db.Decimal(20, 8)
  targetCurrency String       @db.VarChar(8)
  memo           String?      @db.VarChar(500)
  status         TicketStatus @default(OPEN)

  // Smart Escrow & Business Accounts (2026-06-14)
  businessProfileId String? // links to BusinessProfile for business-mode tickets

  // Lifecycle timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?
  cancelledAt    DateTime?
  lastActivityAt DateTime  @default(now())

  friendship      Friendship?      @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  creator         User             @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty    User             @relation("TicketCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id])
  smartEscrow     SmartEscrow? // optional 1:1 — only ESCROW-type tickets
  businessOrder   BusinessOrder? // back-relation, no @relation directive needed
  reservation     Reservation?
  transitBooking  TransitBooking?

  @@index([friendshipId])
  @@index([creatorId])
  @@index([counterpartyId])
  @@index([status])
  @@index([businessProfileId])
  // Powers the dashboard query: WHERE friendshipId=X AND status=Y
  // ORDER BY lastActivityAt DESC.
  @@index([friendshipId, status, lastActivityAt(sort: Desc)])
}

model TicketMessage {
  id       String  @id @default(uuid())
  ticketId String
  senderId Int
  type     String // TEXT | IMAGE | VIDEO | DOCUMENT | AUDIO | LINK | TRANSFER | SYSTEM
  content  String?
  metadata Json? // For transfer details, system-event payloads, etc.

  // Phase UI-3 media columns — same shape as DirectMessage so the
  // chat_media_bubble.dart widget renders identically in either context.
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  // Premium chat fields (Telegram-inspired)
  localId       String?
  status        String    @default("sent")
  editedAt      DateTime?
  editedContent String?
  deletedAt     DateTime?
  reactions     Json      @default("{}")

  // B-1 (2026-06-28): reply-to support
  replyToId         String?
  replyToText       String?
  replyToSenderName String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
  @@index([ticketId, createdAt(sort: Desc)])
  @@index([localId])
}

// =============================================================================
// SMART ESCROW (2026-06-14)
// Real USDC escrow attached 1:1 to an ESCROW-type Ticket. See the funds
// convention in the enum block header above. All balance mutations live in
// services/escrowService.js and are wrapped in prisma.$transaction.
// =============================================================================
model SmartEscrow {
  id         String       @id @default(uuid())
  ticketId   String       @unique
  payerId    Int
  payeeId    Int
  amountUsdc Decimal      @db.Decimal(20, 8)
  feeUsdc    Decimal      @default(0.0) @db.Decimal(20, 8)
  status     EscrowStatus @default(DRAFT)

  // Satisfaction tracking — BOTH must be true for auto-settlement
  payerSatisfied Boolean @default(false)
  payeeSatisfied Boolean @default(false)

  // Terms agreed between parties (filled in ticket workspace)
  deliveryTerms String?   @db.VarChar(1000)
  // Optional delivery deadline
  dueDate       DateTime?

  // Lifecycle timestamps
  fundedAt      DateTime?
  settledAt     DateTime?
  refundedAt    DateTime?
  expiresAt     DateTime? // set on creation: +24h for DRAFT, +30d on FUND
  warningSentAt DateTime? // Work Item 9: inactive-funded expiry warning idempotency

  // Correlation keys — link to TransactionHistory rows
  fundTxHash    String? @unique
  releaseTxHash String? @unique
  refundTxHash  String? @unique

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  ticket         Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  payer          User            @relation("EscrowPayer", fields: [payerId], references: [id])
  payee          User            @relation("EscrowPayee", fields: [payeeId], references: [id])
  dispute        EscrowDispute?
  businessOrder  BusinessOrder? // back-relation, no @relation directive needed
  reservation    Reservation? // back-relation for deposit-protected bookings (2026-06-24)
  transitBooking TransitBooking?
  dineInTab      DineInTab?

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([expiresAt])
}

// =============================================================================
// ESCROW DISPUTE (2026-06-14)
// Escalation record for a SmartEscrow. Admin/worker is assigned, then rules.
// =============================================================================
model EscrowDispute {
  id           String        @id @default(uuid())
  escrowId     String        @unique
  raisedById   Int
  reason       String        @db.VarChar(1000)
  evidenceUrls Json? // String[] of Cloudinary URLs
  status       DisputeStatus @default(PENDING)
  assignedToId Int? // null = unassigned; set = assigned admin/worker

  // Resolution fields (populated when admin rules)
  ruling      DisputeRuling?
  rulingNotes String?        @db.VarChar(2000)
  payerPct    Decimal?       @db.Decimal(5, 2) // for SPLIT rulings
  payeePct    Decimal?       @db.Decimal(5, 2) // for SPLIT rulings (payerPct + payeePct = 100)
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  escrow     SmartEscrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  raisedBy   User        @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  assignedTo User?       @relation("DisputeAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
}

// =============================================================================
// BUSINESS PROFILE (2026-06-14)
// A user-owned business identity with a searchable BIZ-XXXXXXXXX id.
// Business ownership is determined by the existence of this record only —
// no role flip occurs on registration. A user can simultaneously be a
// regular user, a vendor, and a business owner.
// =============================================================================
// =============================================================================
// BUSINESS SUBCATEGORY — Marketplace hierarchy (2026-06-24)
// Pre-seeded lookup table. Wire values are the source of truth for
// BusinessProfile.subcategory. parentWire maps to the BusinessCategory enum.
// =============================================================================
model BusinessSubcategory {
  id           String  @id @default(uuid())
  parentWire   String // maps to BusinessCategory enum, e.g. "FOOD_BEVERAGE"
  wire         String  @unique // e.g. "RESTAURANT_FINE_DINING"
  label        String // "Fine Dining"
  imageUrl     String? // Cloudinary lifestyle photo for the category tile
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@index([parentWire, displayOrder])
  @@index([isActive])
}

model BusinessProfile {
  id              String           @id @default(uuid())
  userId          Int              @unique
  bizId           String           @unique // BIZ-XXXXXXXXX (9 digits after prefix)
  moolrePaymentId String?          @unique // *203*<id># USSD payment ID for businesses (Moolre on-ramp, 2026-06-23)
  // Marketplace hierarchy additions (2026-06-24)
  subcategory     String? // wire value from BusinessSubcategory (e.g. "RESTAURANT_FINE_DINING")
  priceRange      Int? // 1=₵  2=₵₵  3=₵₵₵  4=₵₵₵₵
  amenities       String[] // ["WIFI","PARKING","AC","POOL"] — profile-level amenities
  cuisineTypes    String[] // Food & Bev only: ["GHANAIAN","CHINESE","CONTINENTAL"]
  businessMeta    Json? // category-specific extended fields
  businessName    String           @db.VarChar(100)
  category        BusinessCategory @default(OTHER)
  description     String?          @db.VarChar(500)
  website         String?          @db.VarChar(255)
  logoUrl         String?
  coverPhotoUrl    String?  @db.VarChar(500) // Marketplace UI: business cover photo
  // Ad appearance customization (2026-07-06): lets a business pick its own
  // marketplace card tint from the business portal instead of always
  // inheriting the category-default tint. Hex string e.g. "#FFAA00", null
  // falls back to category tint (existing behavior in collapsible_business_bar.dart).
  adAccentColor    String?  @db.VarChar(7)

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  kybStatus  KybStatus @default(UNVERIFIED)

  // Admin moderation (WS4): a suspended business is hidden/blocked from new
  // activity until an admin unsuspends it. suspendReason is operator-facing.
  isSuspended   Boolean @default(false)
  suspendReason String? @db.VarChar(500)

  // Public contact info
  phoneNumber  String? @db.VarChar(20)
  contactEmail String? @db.VarChar(100)
  address      String? @db.VarChar(255)
  country      String? @db.VarChar(2)

  // Denormalized stats (updated by triggers/workers for fast reads)
  totalEscrows     Int     @default(0)
  completedEscrows Int     @default(0)
  totalVolume      Decimal @default(0.0) @db.Decimal(20, 8)
  averageRating    Decimal @default(0.0) @db.Decimal(3, 2)
  reviewCount      Int     @default(0)

  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets               Ticket[]
  products              BusinessProduct[]
  orders                BusinessOrder[]
  verificationDocuments BusinessVerificationDocument[]
  notifications         BusinessNotification[]

  // Discovery Sprint (2026-06-20): branches, invoices, customer reviews
  locations BusinessLocation[]
  invoices  BusinessInvoice[]
  reviews   BusinessReview[]

  // Marketplace Foundation (2026-06-24): catalog sections, bookable windows, reservations
  catalogSections   CatalogSection[]
  availabilityRules AvailabilityRule[]
  reservations      Reservation[]

  // B-2 (2026-06-28): transit fleet and bookings
  transitVehicles TransitVehicle[]
  transitBookings TransitBooking[]

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  stories       Story[]
  transitTrips  TransitTrip[]
  followers     BusinessFollower[]
  adPosts       BusinessAdPost[]
  dineInTabs    DineInTab[]
  penaltyPolicy PenaltyPolicy?
  showcase      BusinessShowcase[]
  // Business OS relations
  employees          BusinessEmployee[]
  shifts             Shift[]
  shiftSwaps         ShiftSwap[]
  timeOffRequests    TimeOffRequest[]
  payrollRecords     PayrollRecord[]
  ledgerEntries      BusinessLedgerEntry[]
  employeeFeedbacks  EmployeeFeedback[]
  hotelRooms         HotelRoom[]
  housekeepingTasks  HotelHousekeepingTask[]
  kitchenOrders      KitchenOrder[]
  driverAssignments  DriverAssignment[]
  vehicleMaintenances VehicleMaintenance[]
  cargoParcelsSent     CargoParcel[]
  inventoryItems       InventoryItem[]

  @@index([bizId])
  @@index([category])
  @@index([kybStatus])
  @@index([isVerified])
  // Full-text search support: business name search
  @@index([businessName])
  // Public discovery (businessService.searchBusinesses): always filters
  // isSuspended=false, optionally category, and ORDERs BY totalEscrows desc.
  // These composites let Postgres satisfy the filter+sort from the index
  // instead of a full scan + in-memory sort as the marketplace grows.
  @@index([isSuspended, totalEscrows(sort: Desc)])
  @@index([isSuspended, category, totalEscrows(sort: Desc)])
  // Marketplace hierarchy filters (subcategory + priceRange drill-down)
  @@index([subcategory])
  @@index([priceRange])
  @@index([isSuspended, subcategory, totalEscrows(sort: Desc)])
}

// =============================================================================
// DISCOVERY SPRINT (2026-06-20): LOCATIONS, TABLES, INVOICES, REVIEWS
// BusinessLocation is declared BEFORE BusinessProduct because
// BusinessProduct.locationId references it.
// =============================================================================
model BusinessLocation {
  id                String  @id @default(uuid())
  businessProfileId String
  label             String  @db.VarChar(100) // e.g. "Osu Branch", "Main Office"
  address           String  @db.VarChar(255)
  city              String? @db.VarChar(100)
  region            String? @db.VarChar(100)
  country           String? @db.VarChar(2)
  latitude          Decimal @db.Decimal(10, 7) // GPS lat — required for nearby search
  longitude         Decimal @db.Decimal(10, 7) // GPS lng — required for nearby search
  phoneNumber       String? @db.VarChar(20)
  operatingHours    Json? // { mon:"8:00-22:00", tue:"8:00-22:00", ... sun:"closed" }
  galleryUrls       Json? // String[] of Cloudinary URLs — ambiance/storefront photos
  isPrimary         Boolean @default(false) // only one per business should be primary
  isActive          Boolean @default(true)

  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  hotelRooms       HotelRoom[]
  kitchenOrders    KitchenOrder[]
  products        BusinessProduct[] // products available at this specific location
  tables          BusinessTable[]
  invoices        BusinessInvoice[]
  reviews         BusinessReview[]
  sections        CatalogSection[] // catalog sections scoped to this branch (2026-06-24)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  dineInTabs DineInTab[]

  @@index([businessProfileId])
  @@index([businessProfileId, isActive])
  @@index([latitude]) // used by bounding-box nearby search
  @@index([longitude])
}

model BusinessTable {
  id         String  @id @default(uuid())
  locationId String
  label      String  @db.VarChar(50) // e.g. "Table 4", "Counter 1", "VIP Room"
  isActive   Boolean @default(true)

  location BusinessLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  invoices BusinessInvoice[]

  createdAt  DateTime    @default(now())
  dineInTabs DineInTab[]

  @@unique([locationId, label]) // no duplicate table labels within a location
  @@index([locationId])
}

model BusinessInvoice {
  id                 String        @id @default(uuid())
  businessProfileId  String
  locationId         String? // null = invoice not tied to a specific branch
  tableId            String? // null = not a table-based invoice
  customerId         Int // the Azaman user being billed
  invoiceRef         String        @unique // e.g. "INV-260620-A3F2"
  status             InvoiceStatus @default(DRAFT)
  subtotalUsdc       Decimal       @db.Decimal(20, 8) // sum of lineItem totals
  taxTotalUsdc       Decimal       @default(0.0) @db.Decimal(20, 8) // sum of all tax lines
  tipUsdc            Decimal       @default(0.0) @db.Decimal(20, 8) // set at payment time
  billTotalUsdc      Decimal       @db.Decimal(20, 8) // subtotal + taxTotal (pre-tip)
  feeUsdc            Decimal       @default(0.0) @db.Decimal(20, 8) // snapshotted at payment
  customerCoveredFee Boolean       @default(false) // did customer absorb the fee?
  customerPaidUsdc   Decimal?      @db.Decimal(20, 8) // snapshotted at PAID — billTotal + tip + fee if covered
  customerNote       String?       @db.VarChar(500) // optional note from customer at payment
  businessNote       String?       @db.VarChar(500) // note from business at creation
  sentAt             DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  payTxHash          String?       @unique // idempotency anchor — set at PAID

  businessProfile BusinessProfile           @relation(fields: [businessProfileId], references: [id])
  location        BusinessLocation?         @relation(fields: [locationId], references: [id])
  table           BusinessTable?            @relation(fields: [tableId], references: [id])
  customer        User                      @relation("InvoiceCustomer", fields: [customerId], references: [id])
  lineItems       BusinessInvoiceLineItem[]
  taxLines        BusinessInvoiceTaxLine[]
  review          BusinessReview?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dineInTab DineInTab?

  @@index([businessProfileId])
  @@index([businessProfileId, status])
  @@index([customerId])
  @@index([customerId, status])
  @@index([status])
}

model BusinessInvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String  @db.VarChar(200) // e.g. "Jollof Special", "1hr Web Dev"
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(20, 8)
  lineTotal   Decimal @db.Decimal(20, 8) // quantity * unitPrice, snapshotted at creation

  invoice BusinessInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BusinessInvoiceTaxLine {
  id             String      @id @default(uuid())
  invoiceId      String
  name           String      @db.VarChar(100) // e.g. "VAT", "NHIL", "Service Charge"
  type           TaxLineType
  value          Decimal     @db.Decimal(10, 4) // percent (15.0) or flat amount (5.00)
  computedAmount Decimal     @db.Decimal(20, 8) // snapshotted at creation — never re-calc later

  invoice BusinessInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BusinessReview {
  id                String           @id @default(uuid())
  businessProfileId String
  locationId        String?
  reviewerId        Int
  rating            Int // 1–5 integer — validated in service
  comment           String?          @db.VarChar(1000)
  sourceType        ReviewSourceType
  orderId           String?          @unique // one review per order
  invoiceId         String?          @unique // one review per invoice

  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  location        BusinessLocation? @relation(fields: [locationId], references: [id])
  reviewer        User              @relation("BusinessReviewer", fields: [reviewerId], references: [id])
  order           BusinessOrder?    @relation(fields: [orderId], references: [id])
  invoice         BusinessInvoice?  @relation(fields: [invoiceId], references: [id])

  createdAt        DateTime        @default(now())
  photoUrls        Json?
  reservationId    String?         @unique
  transitBookingId String?         @unique
  reservation      Reservation?    @relation(fields: [reservationId], references: [id])
  transitBooking   TransitBooking? @relation(fields: [transitBookingId], references: [id])

  @@index([businessProfileId])
  @@index([businessProfileId, createdAt(sort: Desc)])
}

// =============================================================================
// CATALOG SECTION — Menu/product grouping (2026-06-24)
// Restaurants use "Starters / Mains / Drinks". Hotels use "Rooms / Suites".
// Linked to BusinessProduct via catalogSectionId.
// =============================================================================
model CatalogSection {
  id                String  @id @default(uuid())
  businessProfileId String
  locationId        String? // null = all branches
  name              String  @db.VarChar(100) // "Starters", "Main Course", "Drinks"
  description       String? @db.VarChar(300)
  displayOrder      Int     @default(0)
  availableFrom     String? // "06:00" — section only visible in this time window
  availableTo       String? // "11:00"
  imageUrl          String?
  isActive          Boolean @default(true)

  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  location        BusinessLocation? @relation(fields: [locationId], references: [id])
  products        BusinessProduct[] @relation("SectionProducts")

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([businessProfileId, displayOrder])
}

// =============================================================================
// BUSINESS PRODUCT (2026-06-16)
// A sellable item/service offered by a business. Soft-delete only (isActive).
// =============================================================================
model BusinessProduct {
  id                String            @id @default(uuid())
  businessProfileId String
  name              String            @db.VarChar(200)
  description       String?           @db.VarChar(1000)
  priceUsdc         Decimal           @db.Decimal(20, 8)
  imageUrls         Json? // String[] of Cloudinary URLs
  category          BusinessCategory? // null inherits from profile
  isActive          Boolean           @default(true)
  slug              String            @unique
  totalOrders       Int               @default(0)
  totalRevenue      Decimal           @default(0.0) @db.Decimal(20, 8)

  // Discovery Sprint (2026-06-20): per-branch availability + delivery hints
  locationId        String? // null = available at all branches
  deliveryTerms     String? @db.VarChar(500) // e.g. 'Same day delivery'
  estimatedDelivery String? @db.VarChar(100) // e.g. '2-3 days'

  // Catalog section additions (2026-06-24)
  catalogSectionId String? // which CatalogSection this item belongs to
  isAvailable      Boolean  @default(true) // real-time sold-out toggle
  preparationMins  Int? // estimated prep time in minutes
  tags             String[] // ["SPICY","VEGAN","GLUTEN_FREE","POPULAR","NEW"]
  calorieCount     Int?
  variants         Json? // [{ label:"Small", priceDelta:0 },{ label:"Large", priceDelta:2.5 }]
  modifierGroups   Json? // [{ name:"Add-ons", max:3, options:[{ name:"Extra Sauce", price:0.5 }] }]

  businessProfile BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  location        BusinessLocation? @relation(fields: [locationId], references: [id])
  catalogSection  CatalogSection?   @relation("SectionProducts", fields: [catalogSectionId], references: [id])
  kitchenOrderItems KitchenOrderItem[]
  recipeIngredients RecipeIngredient[]
  orders          BusinessOrder[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dineInTabItems DineInTabItem[]

  @@index([businessProfileId])
  @@index([businessProfileId, isActive])
  @@index([slug])
  @@index([catalogSectionId]) // section → products lookup (2026-06-24)
}

// =============================================================================
// BUSINESS ORDER (2026-06-16)
// Tracks the state of a business order. NEVER moves USDC — all financial
// mutations live in escrowService.js. Linked 1:1 to a SmartEscrow and Ticket.
// =============================================================================
model BusinessOrder {
  id                String              @id @default(uuid())
  businessProfileId String
  customerId        Int
  productId         String?
  escrowId          String?             @unique
  ticketId          String?             @unique
  status            BusinessOrderStatus @default(AWAITING_PAYMENT)
  orderRef          String              @unique
  title             String              @db.VarChar(200)
  description       String?             @db.VarChar(500)
  amountUsdc        Decimal             @db.Decimal(20, 8)
  customerNotes     String?             @db.VarChar(500)
  deliveryNotes     String?             @db.VarChar(500)
  deliveredAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  businessProfile BusinessProfile  @relation(fields: [businessProfileId], references: [id])
  customer        User             @relation("OrderCustomer", fields: [customerId], references: [id])
  product         BusinessProduct? @relation(fields: [productId], references: [id])
  escrow          SmartEscrow?     @relation(fields: [escrowId], references: [id])
  ticket          Ticket?          @relation(fields: [ticketId], references: [id])
  review          BusinessReview? // Discovery Sprint: one optional review per order
  kitchenOrder  KitchenOrder?

  @@index([businessProfileId])
  @@index([businessProfileId, status])
  @@index([customerId])
  @@index([status])
  @@index([productId])
  // Order lists are always ORDERed BY createdAt desc, scoped to either the
  // business (listOrdersForBusiness) or the customer (listOrdersForCustomer),
  // each with an optional status filter. The createdAt-trailing composites let
  // the paginated list read straight from the index.
  @@index([businessProfileId, status, createdAt(sort: Desc)])
  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
}

// =============================================================================
// BUSINESS VERIFICATION DOCUMENT (2026-06-16)
// KYB document submitted by a business. Pre-uploaded Cloudinary URLs only.
// The @@unique([businessProfileId, documentType]) is REQUIRED by the upsert.
// =============================================================================
model BusinessVerificationDocument {
  id                String            @id @default(uuid())
  businessProfileId String
  documentType      KybDocumentType
  documentUrl       String
  status            KybDocumentStatus @default(PENDING)
  reviewedById      Int?
  reviewNotes       String?           @db.VarChar(500)
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?           @relation("KybDocReviewer", fields: [reviewedById], references: [id])

  @@unique([businessProfileId, documentType])
  @@index([businessProfileId])
  @@index([status])
  @@index([documentType])
}

// =============================================================================
// BUSINESS NOTIFICATION (2026-06-17)
// One row per owner-facing event (new order, funded, disputed, settled, …).
// Persisted so the portal shows a feed on load, not just live socket events.
// metadata carries deep-link ids ({ orderId, ticketId, escrowId, productId,
// amount }). Cascades with the BusinessProfile.
// =============================================================================
model BusinessNotification {
  id                String       @id @default(uuid())
  businessProfileId String
  type              BizNotifType
  title             String       @db.VarChar(200)
  body              String       @db.VarChar(500)
  metadata          Json?
  isRead            Boolean      @default(false)
  createdAt         DateTime     @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId, isRead])
  @@index([businessProfileId, createdAt(sort: Desc)])
}

// =============================================================================
// AVAILABILITY RULE — Defines bookable time windows for a business (2026-06-24)
// =============================================================================
model AvailabilityRule {
  id                 String  @id @default(uuid())
  businessProfileId  String
  locationId         String?
  serviceItemId      String? // null = general booking; or a BusinessProduct.id
  dayOfWeek          Int[] // 0=Sun..6=Sat; empty = every day
  startTime          String // "08:00" 24h local
  endTime            String // "22:00"
  slotDurationMins   Int? // null = full-day (hotel rooms, whole-day services)
  maxBookingsPerSlot Int     @default(1)
  isActive           Boolean @default(true)

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([businessProfileId, isActive])
}

// =============================================================================
// RESERVATION — Customer-held booking with optional escrow (2026-06-24)
// Integrates with existing SmartEscrow for deposit-protected bookings.
// NEVER moves USDC directly — escrow mutations stay in escrowService.
// =============================================================================
model Reservation {
  id                 String            @id @default(uuid())
  reservationRef     String            @unique // RES-XXXXXXXX
  businessProfileId  String
  locationId         String?
  customerId         Int
  serviceItemId      String? // BusinessProduct.id (room type, service slot)
  status             ReservationStatus @default(PENDING)
  startDatetime      DateTime
  endDatetime        DateTime
  partySize          Int?              @default(1)
  amountUsdc         Decimal           @db.Decimal(20, 8)
  depositUsdc        Decimal           @default(0) @db.Decimal(20, 8)
  cancellationPolicy String?           @db.VarChar(500)
  customerNotes      String?           @db.VarChar(500)
  businessNotes      String?           @db.VarChar(500)
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  escrowId           String?           @unique
  metadata           Json?

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id])
  customer        User            @relation("CustomerReservations", fields: [customerId], references: [id])
  escrow          SmartEscrow?    @relation(fields: [escrowId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  noShowPenaltyPct  Decimal?        @db.Decimal(5, 4)
  noShowPenaltyUsdc Decimal?        @db.Decimal(20, 8)
  penaltyAmountUsdc Decimal?        @db.Decimal(20, 8)
  penaltyChargedAt  DateTime?
  ticketId          String?         @unique
  ticket            Ticket?         @relation(fields: [ticketId], references: [id])
  review            BusinessReview?

  proposedStartDatetime DateTime?
  proposedEndDatetime   DateTime?
  counterProposeMessage String?  @db.VarChar(500)
  counterProposedAt     DateTime?

  @@index([businessProfileId, startDatetime])
  @@index([customerId])
  @@index([businessProfileId, status])
  @@index([reservationRef])
}

// =============================================================================
// B-2 (2026-06-28): TRANSIT VEHICLE + BOOKING — Ride-hailing and delivery fleet
// =============================================================================

enum TransitBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TransitVehicle {
  id                String  @id @default(uuid())
  businessProfileId String
  type              String // CAR, VAN, TRUCK, MOTORCYCLE, BICYCLE, SCOOTER
  make              String? @db.VarChar(100)
  model             String? @db.VarChar(100)
  year              Int?
  color             String? @db.VarChar(50)
  licensePlate      String? @db.VarChar(20)
  capacity          Int     @default(4) // passenger or cargo capacity
  imageUrl          String?
  isActive          Boolean @default(true)
  driverName        String? @db.VarChar(100)
  driverPhone       String? @db.VarChar(20)
  driverPhotoUrl    String?

  // Additional metadata (insurance docs, permit, etc.)
  metadata Json?

  businessProfile BusinessProfile  @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  bookings        TransitBooking[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transitTrips TransitTrip[]
  seatMap      TransitSeatMap?

  driverAssignments  DriverAssignment[]
  maintenances        VehicleMaintenance[]
  @@index([businessProfileId])
  @@index([businessProfileId, isActive])
  @@index([type])
}

model TransitBooking {
  id                String               @id @default(uuid())
  businessProfileId String
  vehicleId         String?
  customerId        Int
  status            TransitBookingStatus @default(PENDING)
  pickupAddress     String               @db.VarChar(255)
  dropoffAddress    String               @db.VarChar(255)
  pickupLatitude    Decimal?             @db.Decimal(10, 7)
  pickupLongitude   Decimal?             @db.Decimal(10, 7)
  dropoffLatitude   Decimal?             @db.Decimal(10, 7)
  dropoffLongitude  Decimal?             @db.Decimal(10, 7)
  scheduledAt       DateTime?
  pickupTime        DateTime?
  dropoffTime       DateTime?
  amountUsdc        Decimal              @db.Decimal(20, 8)
  feeUsdc           Decimal              @default(0) @db.Decimal(20, 8)
  customerNote      String?              @db.VarChar(500)
  driverNote        String?              @db.VarChar(500)
  rating            Int? // 1–5 customer rating after completion
  reviewComment     String?              @db.VarChar(1000)
  bookingRef        String               @unique // e.g. "TRN-2806-A1B2"
  metadata          Json?

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  vehicle         TransitVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customer        User            @relation("TransitBookingCustomer", fields: [customerId], references: [id])

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  checkedInAt       DateTime?
  escrowId          String?              @unique
  escrow            SmartEscrow?         @relation(fields: [escrowId], references: [id])
  noShowPenaltyPct  Decimal?             @db.Decimal(5, 4)
  noShowPenaltyUsdc Decimal?             @db.Decimal(20, 8)
  penaltyAmountUsdc Decimal?             @db.Decimal(20, 8)
  penaltyChargedAt  DateTime?
  reminderSentAt    DateTime? // set by workers/transitReminderWorker.js once the pre-departure push is sent
  ticketId          String?              @unique
  ticket            Ticket?              @relation(fields: [ticketId], references: [id])
  tripId            String?
  trip              TransitTrip?         @relation(fields: [tripId], references: [id])
  seats             TransitBookingSeat[]
  review            BusinessReview?

  @@index([businessProfileId])
  @@index([businessProfileId, status])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
}

// =============================================================================
// MASTER SPRINT (2026-05-27): VAULTS, SUSU, SMART ROUTE, AZM AUCTION
// =============================================================================

// ── PHASE 1: SOLO VAULT ──────────────────────────────────────────────────────
//
// A locked escrow wallet with gamified deposit rules. Users accept a "Rules
// of the Game" pop-up before creating, defining:
//   • A target amount + maturity date (hard lockup)
//   • Optional auto-deposit rule (cron-fired)
//   • An early-break penalty (default 5%)
//
// Funds live OUTSIDE availableBalance — tracked on Vault.currentAmountUsdc.
// The vaultWorker sweeps matured vaults nightly and routes funds back to
// availableBalance + writes a receipt snapshot. AZM intensity rewards are
// computed per-deposit (Amount × Frequency multiplier × streak bonus).
// =============================================================================

model Vault {
  id                String      @id @default(uuid())
  userId            Int
  name              String      @db.VarChar(60)
  targetAmountUsdc  Decimal     @db.Decimal(20, 8)
  currentAmountUsdc Decimal     @default(0) @db.Decimal(20, 8)
  status            VaultStatus @default(ACTIVE)

  // Rules-of-the-game contract (mandatory acceptance before creation)
  rulesAcceptedAt      DateTime
  rulesAcceptedVersion Int      @default(1)
  earlyBreakPenaltyPct Decimal  @default(0.05) @db.Decimal(5, 4)
  isLocked             Boolean  @default(true)

  // Timeline
  startDate    DateTime  @default(now())
  maturityDate DateTime
  completedAt  DateTime?
  brokenAt     DateTime?

  // Auto-deposit rule (1:1 with vault — null means manual-only)
  autoRuleEnabled    Boolean         @default(false)
  autoRuleAmountUsdc Decimal?        @db.Decimal(20, 8)
  autoRuleFrequency  VaultFrequency?
  autoRuleNextRun    DateTime? // cron scans this column

  // Gamification
  streakCount      Int     @default(0)
  longestStreak    Int     @default(0)
  missedCount      Int     @default(0)
  consistencyScore Decimal @default(0) @db.Decimal(5, 2)
  totalAzmEarned   Decimal @default(0) @db.Decimal(20, 8)

  // Receipt snapshot (denormalised on completion for fast UI render)
  receiptSnapshot Json?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits VaultDeposit[]

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([autoRuleEnabled, autoRuleNextRun])
  @@index([status, maturityDate])
}

model VaultDeposit {
  id         String             @id @default(uuid())
  vaultId    String
  userId     Int
  amountUsdc Decimal            @db.Decimal(20, 8)
  type       VaultDepositType
  status     VaultDepositStatus @default(COMPLETED)

  // AZM intensity reward breakdown (rendered verbatim in the FE explainer)
  azmAwarded   Decimal @default(0) @db.Decimal(20, 8)
  azmBreakdown Json?

  // For AUTO_RULE: did the cron find idle funds?
  scheduledFor  DateTime?
  attemptedAt   DateTime  @default(now())
  failureReason String?

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([vaultId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// ── PHASE 2: GROUP CHAT + SUSU ─────────────────────────────────────────────
//
// Group chat is a parallel surface to DirectMessage (which is friend-pair
// scoped). Conversation is reserved for trade rooms — both stay untouched.
// Groups can be Susu-enabled by binding a SusuGroup row.
// =============================================================================

model GroupChat {
  id          String          @id @default(uuid())
  name        String          @db.VarChar(80)
  description String?         @db.VarChar(280)
  avatarUrl   String?
  createdById Int
  status      GroupChatStatus @default(ACTIVE)

  // 1:0..1 binding to SusuGroup. Set when admin starts a susu inside the group.
  susuGroupId String? @unique

  members      GroupMember[]
  messages     GroupMessage[]
  vouchRecords VouchRecord[]
  joinRequests GroupJoinRequest[]
  susuGroup    SusuGroup?         @relation("GroupSusu", fields: [susuGroupId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("GroupChatCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

model GroupMember {
  id            String    @id @default(uuid())
  groupId       String
  userId        Int
  role          GroupRole @default(MEMBER)
  joinedAt      DateTime  @default(now())
  removedAt     DateTime?
  removedReason String?

  // PHASE 6: vouch lineage. addedById = who added/vouched for this member
  // (admin self-add → admin; member proposal → proposer). vouchedById = the
  // resolved voucher for Susu purposes (defaults to addedById). These let the
  // initiation split compute Vouched/Unvouched without a separate join, and
  // VouchRecord creation pulls voucherId from vouchedById at activation.
  addedById   Int?
  vouchedById Int?

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

// ── PHASE 6: GROUP JOIN REQUEST (member-proposed add → admin approval) ──────
// A persisted proposal by one group member (the proposer / voucher-to-be) to
// add a target user to a group. Pending until the admin approves or rejects.
// On approval the target becomes a GroupMember with vouchedById = proposerId.
model GroupJoinRequest {
  id           String                 @id @default(uuid())
  groupId      String
  proposerId   Int // the voucher-to-be
  targetUserId Int
  note         String? // free-text reason, surfaced in notifications
  status       GroupJoinRequestStatus @default(PENDING)
  decidedById  Int? // admin who approved/rejected
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())

  group    GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposer User      @relation("GJRProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  target   User      @relation("GJRTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, targetUserId, status])
  @@index([groupId, status])
  @@index([targetUserId, status])
}

model GroupMessage {
  id       String  @id @default(uuid())
  groupId  String
  senderId Int?
  type     String // TEXT | IMAGE | VIDEO | DOCUMENT | AUDIO | LINK | SYSTEM | SUSU_EVENT | VOUCH_REQUEST
  content  String?
  metadata Json?

  // Same media columns as DirectMessage / TicketMessage
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  // Premium chat fields (Telegram-inspired)
  localId       String?
  status        String    @default("sent")
  editedAt      DateTime?
  editedContent String?
  deletedAt     DateTime?
  reactions     Json      @default("{}")

  // B-1 (2026-06-28): reply-to support
  replyToId         String?
  replyToText       String?
  replyToSenderName String?

  // B-1 (2026-06-28): sticker support
  stickerAssetPath  String?
  stickerIsAnimated Boolean?

  group  GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User?     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([groupId, type])
  @@index([localId])
}

model VouchRecord {
  id           String  @id @default(uuid())
  groupId      String
  inviteeId    Int? // nullable: pre-registration vouches link by phone
  inviteePhone String? // phone-based vouch target (auto-linked on signup)
  voucherId    Int
  isInviter    Boolean @default(false)

  // The Vouch Form payload
  relationship        String  @db.VarChar(80)
  durationKnown       String  @db.VarChar(40)
  reasonForTrust      String  @db.VarChar(500)
  acknowledgesPenalty Boolean @default(false)

  status      VouchStatus @default(PENDING)
  submittedAt DateTime?

  group   GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee User?     @relation("VouchInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  voucher User      @relation("VouchVoucher", fields: [voucherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([groupId, inviteeId])
  @@index([voucherId])
  @@index([status])
  @@index([inviteePhone]) // registration hook scans this
}

model SusuGroup {
  id        String     @id @default(uuid())
  groupChat GroupChat? @relation("GroupSusu")

  status                SusuStatus    @default(CONFIGURING)
  contributionUsdc      Decimal       @db.Decimal(20, 8)
  frequency             SusuFrequency
  totalCycles           Int
  startDate             DateTime
  contractAcceptedCount Int           @default(0)
  contractRequiredCount Int

  // Smart-rotation snapshot at start (immutable order for UI)
  rotationSnapshot Json

  // ── PRIVATE SUSU ECOSYSTEM (2026-05-31) ────────────────────────────────
  // Liability_Contract version pinned at activation time (Req 4.10)
  contractVersion String?
  contractHash    String?
  // Activation timestamp distinct from startDate so we can tell pre-activation
  // Susus apart from active ones (Req 8.7)
  activatedAt     DateTime?
  // Circuit Breaker freeze record (Req 11.9)
  frozenAt        DateTime?
  frozenReason    String?

  // ── PHASE 5 / Workstream D (2026-06-01): Group-chat-first initiation ──
  // When an admin clicks "Initiate Susu" inside a group chat, the SusuGroup
  // is created in CONFIGURING with an initiation countdown. Every member
  // must reach KYC=VERIFIED + PoR=VERIFIED + contract acceptance before the
  // deadline, or the initiation-sweep worker removes them from the group
  // and either activates with the verified set or aborts.
  initiationDeadline DateTime?
  initiatedById      Int?

  members              SusuMember[]
  cycles               SusuCycle[]
  invites              SusuInvite[]
  liabilityAcceptances LiabilityAcceptance[]
  voucherSlashLogs     VoucherSlashLog[]
  reminderRows         SusuReminderSent[]
  warRoomAlerts        AdminWarRoomAlert[]

  createdAt DateTime @default(now())
  // QR Code Forge — reprogrammable redirect (2026-07-14)
  qrRedirectUrl String @default("https://startup.moolre.com/leaderboard/118")
  qrLabel       String @default("Azaman Vote Page")

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
}

model SusuMember {
  id                 String           @id @default(uuid())
  susuGroupId        String
  userId             Int
  cycleSlot          Int
  trustScore         Decimal          @db.Decimal(8, 4)
  status             SusuMemberStatus @default(PENDING_CONTRACT)
  contractAcceptedAt DateTime?

  // Vouch chain that admitted this member
  inviterId   Int?
  vouchedById Int?

  // Default tracking
  defaultedAt     DateTime?
  totalSeizedUsdc Decimal   @default(0) @db.Decimal(20, 8)

  // ── PHASE 5 / Workstream B (2026-06-01): auto-retain opt-in ──
  // When true, the member has asked the platform to keep the next
  // contribution amount reserved from their availableBalance after a
  // payout, so the upcoming cycle self-funds without a manual top-up.
  // Honoured by the Reminder_Cron / cycle funding logic (Workstream C).
  autoRetainNextCycle Boolean @default(false)

  susu          SusuGroup          @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  user          User               @relation("SusuMembership", fields: [userId], references: [id], onDelete: Cascade)
  contributions SusuContribution[]
  reminderRows  SusuReminderSent[]

  @@unique([susuGroupId, userId])
  @@unique([susuGroupId, cycleSlot])
  @@index([userId])
  @@index([status])
}

model SusuCycle {
  id             String          @id @default(uuid())
  susuGroupId    String
  cycleNumber    Int
  collectionDate DateTime
  payoutAmount   Decimal         @db.Decimal(20, 8)
  payoutUserId   Int
  status         SusuCycleStatus @default(PENDING)

  paidOutAt     DateTime?
  defaultsCount Int       @default(0)

  // ── PRIVATE SUSU ECOSYSTEM (2026-05-31) ────────────────────────────────
  // Set when Cycle_Scheduler transitions PENDING → COLLECTING (Req 10.1)
  startedCollectingAt DateTime?
  // Non-null when payout was diverted to azaman-treasury because the
  // designated payoutUser had defaulted (Req 10.8)
  escrowDivertedAt    DateTime?

  // ── PHASE 5 / Workstream C (2026-06-01): Grace window deadline ──
  // Set when the cycle enters COLLECTING_GRACE. The Cycle_Scheduler keeps
  // re-evaluating the cycle while now() < graceUntil (members may top up
  // and fund); once now() >= graceUntil any still-short member is
  // hard-defaulted and the cycle is finalized.
  graceUntil DateTime?

  // ── PHASE 6 / Phase 5 (2026-06-01): Susu Profit Engine ──
  // Platform fee deducted from the pooled contribution before payout.
  // Calculated as ROUND_DOWN(pooled × GlobalSettings.susuProfitPct).
  // Persisted for audit and transparency. takeHome = pooled - feeUsdc.
  feeUsdc Decimal? @db.Decimal(20, 8)

  susu             SusuGroup           @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  payoutUser       User                @relation("SusuCycleWinner", fields: [payoutUserId], references: [id])
  contributions    SusuContribution[]
  voucherSlashLogs VoucherSlashLog[]
  reminderRows     SusuReminderSent[]
  warRoomAlerts    AdminWarRoomAlert[]

  @@unique([susuGroupId, cycleNumber])
  @@index([status, collectionDate])
  @@index([payoutUserId])
  @@index([susuGroupId, status])
  @@index([susuGroupId, cycleNumber])
}

model SusuContribution {
  id                  String                 @id @default(uuid())
  cycleId             String
  memberId            String
  userId              Int
  amountUsdc          Decimal                @db.Decimal(20, 8)
  status              SusuContributionStatus
  collectedAt         DateTime               @default(now())
  seizedFromAvailable Decimal                @default(0) @db.Decimal(20, 8)
  shortfall           Decimal                @default(0) @db.Decimal(20, 8)

  cycle  SusuCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member SusuMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user   User       @relation("SusuContributor", fields: [userId], references: [id])

  @@unique([cycleId, memberId])
  @@index([userId])
  @@index([status])
  @@index([cycleId, status])
  @@index([cycleId, userId])
}

// =============================================================================
// PRIVATE SUSU ECOSYSTEM — NEW TABLES (2026-05-31)
// =============================================================================
//
// Strictly additive overlay on the deployed SusuGroup / SusuMember /
// SusuCycle / SusuContribution / VouchRecord scaffolding. Each new table
// powers a specific requirement from
// .kiro/specs/private-susu-ecosystem/requirements.md:
//
//   SusuInvite               — Req 6 (three-channel invites)
//   LiabilityContractVersion — Req 4 (versioned contract bodies + hashes)
//   LiabilityAcceptance      — Req 4 (per-user / per-Susu acceptance audit)
//   VoucherSlashLog          — Req 7 (immutable AZM/trust slash record)
//   SusuReminderSent         — Req 13 (T-24h reminder idempotency)
//   AdminWarRoomAlert        — Req 10.12 / Req 11.9 (Circuit Breaker + escrow alerts)
//
// All tables key off SusuGroup.id (the existing Susu identifier). VouchRecord
// continues to power the rich Vouch-Form workflow; new SusuInvite rows
// trigger VouchRecord creation through SusuVouch_Service in Phase 2.
// =============================================================================

model SusuInvite {
  id            String            @id @default(uuid())
  susuGroupId   String
  inviterId     Int
  inviteeUserId Int? // null until a PHONE invite is bound to a verified phone
  inviteePhone  String? // E.164 normalised; populated only for PHONE channel
  channel       SusuInviteChannel
  token         String?           @unique // 32-byte URL-safe random for LINK channel only
  status        SusuInviteStatus  @default(PENDING)
  expiresAt     DateTime
  redeemedAt    DateTime?
  createdAt     DateTime          @default(now())

  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  inviter User      @relation("SusuInviteInviter", fields: [inviterId], references: [id])
  invitee User?     @relation("SusuInviteInvitee", fields: [inviteeUserId], references: [id])

  @@index([susuGroupId, status])
  @@index([inviteeUserId, status])
  @@index([inviteePhone, status])
}

model LiabilityContractVersion {
  id           String   @id @default(uuid())
  version      String   @unique // e.g. "v1.0", "v1.1"
  contractHash String   @unique // SHA-256 of body
  body         String   @db.Text
  publishedAt  DateTime @default(now())
  publishedBy  Int

  publisher User @relation("ContractPublisher", fields: [publishedBy], references: [id])

  @@index([publishedAt(sort: Desc)])
}

model LiabilityAcceptance {
  id              String   @id @default(uuid())
  userId          Int
  susuGroupId     String
  contractVersion String
  contractHash    String
  acceptedAt      DateTime @default(now())
  ipAddress       String
  userAgent       String

  // ── PHASE 6 / Phase 4 (2026-06-01): Consent & Voucher tracking ──────────
  // acknowledgedClauses: JSON array of clause keys the user ticked in the
  // Consent_Gate modal (e.g., ["seizure", "tracing", "named_voucher"]).
  // Persisted for audit and future enforcement. Nullable for backward
  // compatibility with existing acceptances.
  acknowledgedClauses Json?
  // voucherUserId: the User.id of the member who vouched for this user at
  // acceptance time. Nullable: null means the user was already a group member
  // (no vouch needed) or was auto-vouched by the initiator.
  voucherUserId       Int?

  user    User      @relation(fields: [userId], references: [id])
  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  voucher User?     @relation("LiabilityVoucher", fields: [voucherUserId], references: [id])

  @@unique([userId, susuGroupId, contractVersion])
  @@index([susuGroupId])
  @@index([voucherUserId])
  @@index([contractVersion])
  @@index([userId, susuGroupId])
}

model VoucherSlashLog {
  id                String   @id @default(uuid())
  voucherId         Int? // nullable for absent-vouch case (Req 7.4)
  vouchedUserId     Int
  susuGroupId       String
  cycleId           String
  azmDeducted       Decimal  @db.Decimal(20, 8)
  trustRatingBefore Int
  trustRatingAfter  Int
  appliedAt         DateTime @default(now())

  voucher User?     @relation("SlashVoucher", fields: [voucherId], references: [id])
  vouched User      @relation("SlashVouched", fields: [vouchedUserId], references: [id])
  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  cycle   SusuCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([susuGroupId, cycleId])
  @@index([vouchedUserId])
  @@index([vouchedUserId, appliedAt(sort: Desc)])
}

model SusuReminderSent {
  id           String   @id @default(uuid())
  susuMemberId String
  susuCycleId  String
  susuGroupId  String // denormalised for cleanup convenience
  reminderType String // 'T_24H_SHORTFALL' for now; expandable
  sentAt       DateTime @default(now())

  member SusuMember @relation(fields: [susuMemberId], references: [id], onDelete: Cascade)
  cycle  SusuCycle  @relation(fields: [susuCycleId], references: [id], onDelete: Cascade)
  susu   SusuGroup  @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)

  @@unique([susuMemberId, susuCycleId, reminderType])
  @@index([susuCycleId])
}

model AdminWarRoomAlert {
  id             String                @id @default(uuid())
  alertType      AdminWarRoomAlertType
  susuGroupId    String
  cycleId        String?
  payload        Json
  createdAt      DateTime              @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy Int?

  // ── PHASE 5 / Workstream E (2026-06-01): incident resolution ──
  // How the admin closed the incident from the War Room: RESUME (lift the
  // FROZEN_DISPUTE freeze and let cycles continue) or REFUND_AND_CLOSE
  // (return the frozen pool to members and cancel the Susu). Null until the
  // incident is resolved.
  resolution String?
  resolvedAt DateTime?
  resolvedBy Int?

  susu  SusuGroup  @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  cycle SusuCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  ackBy User?      @relation("AlertAcknowledger", fields: [acknowledgedBy], references: [id])

  @@index([acknowledgedAt, createdAt(sort: Desc)])
  @@index([susuGroupId])
  @@index([alertType])
  @@index([alertType, acknowledgedAt])
}

