// =============================================================================
// V3: SOCIAL FRIEND SYSTEM — Friendship, Direct Messaging & Peer Transfers
// =============================================================================

model Friendship {
  id          String           @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  message     String? // Intro message sent with friend request

  // Phase UI-5 (2026-05-26): Per-friendship local nicknames. JSON map of
  // `{ "<observerUserId>": "<nickname they set for the other person>" }`.
  // Each side of the friendship can set their own nickname; both are
  // stored in the same map keyed by the OBSERVER's userId.
  localNicknames Json @default("{}")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  directMessages DirectMessage[]
  peerTransfers  PeerTransfer[]
  // Phase UI-4 (2026-05-26): Tickets Engine
  tickets        Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  // Phase I: powers cursor pagination on GET /api/friends.
  // Query: WHERE (requesterId=X OR addresseeId=X) AND status='ACCEPTED'
  //        ORDER BY updatedAt DESC. The OR predicate needs both shapes —
  //        Postgres BitmapOrs them and feeds the merged set into a top-K.
  @@index([requesterId, status, updatedAt(sort: Desc)])
  @@index([addresseeId, status, updatedAt(sort: Desc)])
}

model DirectMessage {
  id           String            @id @default(uuid())
  friendshipId String
  senderId     Int
  receiverId   Int
  content      String
  messageType  DirectMessageType @default(TEXT)
  metadata     Json? // For transfer details (amount, reference, transferId)
  isRead       Boolean           @default(false)

  // Phase UI-3 (2026-05-26): media columns for rich-media chat.
  // Used when messageType is IMAGE, VIDEO, DOCUMENT, AUDIO, or LINK.
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender     User       @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User       @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([friendshipId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  // Phase I: powers cursor pagination on GET /api/friends/chat/:friendshipId
  // (filter friendshipId, order createdAt desc).
  @@index([friendshipId, createdAt(sort: Desc)])
}

model PeerTransfer {
  id           String             @id @default(uuid())
  friendshipId String
  senderId     Int // Person sending / person being requested from
  receiverId   Int // Person receiving / person requesting
  amount       Decimal            @db.Decimal(20, 8)
  currency     String             @default("USDC")
  reference    String? // Reason/note for the transfer
  type         PeerTransferType // SEND or REQUEST
  status       PeerTransferStatus @default(PENDING)

  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender     User       @relation("PeerTransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User       @relation("PeerTransferReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([friendshipId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([type])
}

// =============================================================================
// V3: AD INTERACTION ANALYTICS
// Records every interaction a user has with a vendor ad for metrics tracking.
// =============================================================================

model AdInteraction {
  id        String            @id @default(uuid())
  adId      Int
  userId    Int
  type      AdInteractionType // VIEWED, TRADE_INITIATED, CLOSED
  metadata  Json? // Optional: device info, session duration, etc.
  createdAt DateTime          @default(now())

  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([adId, type])
}

// =============================================================================
// V3: VENDOR ACHIEVEMENT SYSTEM
// Tracks earned achievements/badges for vendor gamification.
// =============================================================================

model VendorAchievement {
  id            String   @id @default(uuid())
  userId        Int
  achievementId String // Reference to achievement definition
  name          String // Display name
  description   String // What the vendor did to earn it
  iconName      String // Frontend icon identifier
  xpAwarded     Int      @default(0) // XP given when achievement was unlocked
  tier          String   @default("COMMON") // COMMON, RARE, EPIC, LEGENDARY
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// =============================================================================
// PHASE E1: AZM REWARD LOG — Tracks every AZM credit event
// Every time a user earns AZM (trade completion, login streak, referral,
// achievement unlock, etc.), a row is written here. Provides a transparent
// audit trail for the loyalty-point system and powers the "AZM History"
// screen in the frontend.
// =============================================================================

model AzmRewardLog {
  id           String   @id @default(uuid())
  userId       Int
  amount       Decimal  @db.Decimal(20, 8) // AZM credited (always positive — debits are a future Phase E2 concern)
  reason       String // Human-readable description
  source       String // Machine key: TRADE_COMPLETE, LOGIN_STREAK, REFERRAL_BONUS, ACHIEVEMENT_UNLOCK, MILESTONE
  metadata     Json? // Optional context (tradeId, streak count, achievement name, etc.)
  balanceAfter Decimal  @default(0.0) @db.Decimal(20, 8) // User's azmBalance after this credit
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([source])
  @@index([userId, source])
}

// =============================================================================
// PHASE E2: AZM SPEND LOG — Tracks every AZM debit event
// Every time a user spends AZM (fee discounts, ad boosts, etc.), a row is
// written here. Provides a transparent audit trail for the loyalty-point
// spend side and powers the "AZM Spend History" in the frontend.
// =============================================================================

model AzmSpendLog {
  id           String   @id @default(uuid())
  userId       Int
  amount       Decimal  @db.Decimal(20, 8) // AZM debited (always positive — the direction is implied by the table)
  reason       String // Human-readable description
  source       String // Machine key: FEE_DISCOUNT, AD_BOOST
  metadata     Json? // Optional context (tierId, adId, discount percentage, etc.)
  balanceAfter Decimal  @default(0.0) @db.Decimal(20, 8) // User's azmBalance after this debit
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([source])
  @@index([userId, source])
}

// =============================================================================
// V3: SAVINGS SYSTEM — Goal-Based Savings with Gamification
// Users set savings targets with scheduled deposits. Funds are locked until
// the goal end date. Early withdrawal incurs a penalty. Streaks reward
// consistency.
// =============================================================================

model SavingsGoal {
  id                     String    @id @default(uuid())
  userId                 Int
  name                   String    @default("My Savings")
  targetAmountGhs        Decimal   @db.Decimal(20, 8) // Total target in GHS
  currentAmountGhs       Decimal   @default(0.0) @db.Decimal(20, 8) // Progress so far (GHS equivalent)
  frequencyAmount        Decimal   @db.Decimal(20, 8) // Amount per scheduled deposit (GHS)
  frequency              String    @default("WEEKLY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY
  startDate              DateTime  @default(now())
  endDate                DateTime? // When the goal matures (null = open-ended)
  nextDueDate            DateTime? // Next scheduled deposit date
  status                 String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED, CANCELLED
  streakCount            Int       @default(0) // Consecutive on-time deposits
  longestStreak          Int       @default(0)
  missedCount            Int       @default(0) // Times the user missed a deposit
  totalDeposits          Int       @default(0) // Count of successful deposits
  isLocked               Boolean   @default(true) // Whether early withdrawal is penalized
  earlyWithdrawalPenalty Decimal   @default(0.02) @db.Decimal(10, 4) // 2% penalty for breaking lock

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits SavingsDeposit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([nextDueDate])
}

model SavingsDeposit {
  id         String  @id @default(uuid())
  goalId     String
  userId     Int
  amountGhs  Decimal @db.Decimal(20, 8) // Amount deposited in GHS
  amountUsdc Decimal @db.Decimal(20, 8) // USDC equivalent at time of deposit
  type       String  @default("SCHEDULED") // SCHEDULED, MANUAL, BONUS
  status     String  @default("COMPLETED") // COMPLETED, FAILED, PENDING

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([userId])
}

// =============================================================================
// PHASE Q1: ADMIN FEE PROFILES — Dynamic Margin/Split Control
//
// The admin can create fee profiles that override the default platform fee
// percentages and admin/vendor split ratios. Profiles target specific scopes
// (all users, vendor tiers, influencer referrals, holiday promos) and have
// optional time windows. The highest-priority matching profile wins.
//
// Resolution logic (in services/feeProfileService.js):
//   1. Find active profiles where validFrom <= now <= validUntil (or null)
//   2. Filter to those matching the trade context (user referral, vendor tier, ALL)
//   3. Pick highest priority
// =============================================================================
// PHASE Q12: RATE ALERT SYSTEM
//
// Users set price alerts ("Notify me when USD/GHS crosses X").
// The oracle service checks all active, un-triggered alerts on each rate sync.
// When a threshold is crossed, the alert is marked triggered and a notification
// is sent via notificationService.
// =============================================================================

model RateAlert {
  id            String    @id @default(uuid())
  userId        Int
  targetRate    Decimal   @db.Decimal(18, 8) // The rate threshold
  direction     String    @default("ABOVE") // ABOVE | BELOW
  ratePair      String    @default("USD_GHS") // Which rate pair to watch
  isTriggered   Boolean   @default(false)
  triggeredAt   DateTime?
  triggeredRate Decimal?  @db.Decimal(18, 8) // The rate when alert fired
  isActive      Boolean   @default(true)
  note          String? // User's optional label

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([isActive, isTriggered, direction, targetRate])
  @@index([userId, createdAt(sort: Desc)])
}

// =============================================================================
// PHASE Q14: DISPUTE RESOLUTION — Structured Admin Workflow
//
// When a trade enters DISPUTED status, an admin can resolve it via:
//   1. Assign (auto or manual)
//   2. Review (chat history, proofs, user stats)
//   3. Rule (BUYER_WINS, VENDOR_WINS, SPLIT)
//   4. Auto-execute (escrow release, notifications, stats update)
// =============================================================================

model DisputeResolution {
  id           String    @id @default(uuid())
  tradeId      Int       @unique // One resolution per trade
  adminId      Int // Admin who resolved
  ruling       String // BUYER_WINS | VENDOR_WINS | SPLIT
  reason       String // Admin's explanation (required)
  buyerAmount  Decimal   @default(0) @db.Decimal(20, 8) // USDC credited to buyer
  vendorAmount Decimal   @default(0) @db.Decimal(20, 8) // USDC credited to vendor
  totalEscrow  Decimal   @db.Decimal(20, 8) // Total escrow at resolution time
  status       String    @default("PENDING") // PENDING | EXECUTED | FAILED
  executedAt   DateTime?

  trade Trade @relation(fields: [tradeId], references: [id])
  admin User  @relation("DisputeResolutionAdmin", fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PHASE V: VENDOR APPLICATION — Binance-Level Merchant Registration
//
// Users submit comprehensive KYC + financial information to become vendors.
// Admin reviews in the War Room → APPROVED triggers role change USER → VENDOR.
// =============================================================================

enum VendorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SourceOfFunds {
  EMPLOYMENT
  BUSINESS
  INVESTMENTS
  SAVINGS
  OTHER
}

enum MonthlyVolumeEstimate {
  TIER_1 // $0 – $1,000
  TIER_2 // $1,000 – $5,000
  TIER_3 // $5,000 – $20,000
  TIER_4 // $20,000+
}

model VendorApplication {
  id     String                  @id @default(uuid())
  userId Int
  status VendorApplicationStatus @default(PENDING)

  // Step 1: Personal Identity
  legalName    String
  dateOfBirth  String
  country      String
  idType       String // NATIONAL_ID | PASSPORT | DRIVERS_LICENSE
  idImageFront String? // URL after upload
  idImageBack  String? // URL (optional)
  selfieWithId String? // URL after upload

  // Step 2: Proof of Address
  proofOfAddress String? // URL after upload
  addressStreet  String
  addressCity    String
  addressRegion  String
  addressPostal  String?

  // Step 3: Financial Background
  sourceOfFunds         SourceOfFunds         @default(EMPLOYMENT)
  sourceOfFundsOther    String? // Free text if OTHER
  monthlyVolumeEstimate MonthlyVolumeEstimate @default(TIER_1)
  hasPreviousExperience Boolean               @default(false)
  previousPlatforms     String? // Comma-separated platform names

  // Step 4: Payment Methods (stored as JSON array)
  paymentMethods Json @default("[]")

  // Step 5: Terms & Collateral
  acceptedTerms    Boolean @default(false)
  collateralAmount Decimal @default(500) @db.Decimal(20, 8)

  // Admin Review
  reviewedBy      Int? // Admin user ID
  reviewedAt      DateTime?
  rejectionReason String?
  adminNotes      String?

  // Relations
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VendorApplicationReviewer", fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// LINK PREVIEW CACHE (Phase UI-3, 2026-05-26)
//
// Caches Open Graph metadata fetched server-side so:
//   • Clients never deal with CORS/network issues fetching arbitrary URLs.
//   • Two users sharing the same link don't hit the origin twice.
//   • The 24h TTL is enforced via the `expiresAt` column read in the
//     linkPreviewService — entries past their expiry are re-fetched.
// =============================================================================
model LinkPreviewCache {
  id          String   @id @default(uuid())
  urlHash     String   @unique // sha256 of normalised URL — index target
  url         String // original URL (for debugging / re-fetch)
  title       String?
  description String?  @db.Text
  image       String? // primary OG image URL
  favicon     String?
  siteName    String?
  status      String   @default("OK") // OK | FAILED | TIMEOUT | BLOCKED
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([urlHash])
  @@index([expiresAt])
}

// =============================================================================
// TICKETS ENGINE (Phase UI-4, 2026-05-26)
//
// Tickets are isolated, trackable chat workspaces generated INSIDE an
// existing peer-to-peer friendship to record a specific business deal,
// transaction, or agreement. They are NOT escrow-backed P2P trades —
// those remain the formal `Trade` flow with `escrowLockedBalance`. Tickets
// are lightweight social-transactional records that two friends create
// to track an off-platform deal, service swap, or escrow arrangement
// they're negotiating.
//
// Ticket lifecycle:
//   OPEN      — newly created, both parties can post messages
//   CLOSED    — parties marked the deal complete (immutable thereafter)
//   CANCELLED — parties abandoned the negotiation (immutable thereafter)
//
// On creation, a TICKET_LINK DirectMessage is injected into the parent
// friendship chat so both parties see the event card in their main feed
// and can deep-link into the ticket workspace.
// =============================================================================

enum TicketType {
  BUY
  SELL
  ESCROW
  SERVICE_SWAP
}

enum TicketStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Ticket {
  id             String       @id @default(uuid())
  friendshipId   String
  creatorId      Int
  counterpartyId Int
  name           String       @db.VarChar(80)
  type           TicketType
  targetAmount   Decimal      @db.Decimal(20, 8)
  targetCurrency String       @db.VarChar(8)
  memo           String?      @db.VarChar(500)
  status         TicketStatus @default(OPEN)

  // Lifecycle timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?
  cancelledAt    DateTime?
  lastActivityAt DateTime  @default(now())

  friendship   Friendship      @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  creator      User            @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty User            @relation("TicketCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)
  messages     TicketMessage[]

  @@index([friendshipId])
  @@index([creatorId])
  @@index([counterpartyId])
  @@index([status])
  // Powers the dashboard query: WHERE friendshipId=X AND status=Y
  // ORDER BY lastActivityAt DESC.
  @@index([friendshipId, status, lastActivityAt(sort: Desc)])
}

model TicketMessage {
  id       String  @id @default(uuid())
  ticketId String
  senderId Int
  type     String // TEXT | IMAGE | VIDEO | DOCUMENT | AUDIO | LINK | TRANSFER | SYSTEM
  content  String?
  metadata Json? // For transfer details, system-event payloads, etc.

  // Phase UI-3 media columns — same shape as DirectMessage so the
  // chat_media_bubble.dart widget renders identically in either context.
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
  @@index([ticketId, createdAt(sort: Desc)])
}

// =============================================================================
// MASTER SPRINT (2026-05-27): VAULTS, SUSU, SMART ROUTE, AZM AUCTION
// =============================================================================

// ── PHASE 1: SOLO VAULT ──────────────────────────────────────────────────────
//
// A locked escrow wallet with gamified deposit rules. Users accept a "Rules
// of the Game" pop-up before creating, defining:
//   • A target amount + maturity date (hard lockup)
//   • Optional auto-deposit rule (cron-fired)
//   • An early-break penalty (default 5%)
//
// Funds live OUTSIDE availableBalance — tracked on Vault.currentAmountUsdc.
// The vaultWorker sweeps matured vaults nightly and routes funds back to
// availableBalance + writes a receipt snapshot. AZM intensity rewards are
// computed per-deposit (Amount × Frequency multiplier × streak bonus).
// =============================================================================

model Vault {
  id                String      @id @default(uuid())
  userId            Int
  name              String      @db.VarChar(60)
  targetAmountUsdc  Decimal     @db.Decimal(20, 8)
  currentAmountUsdc Decimal     @default(0) @db.Decimal(20, 8)
  status            VaultStatus @default(ACTIVE)

  // Rules-of-the-game contract (mandatory acceptance before creation)
  rulesAcceptedAt      DateTime
  rulesAcceptedVersion Int      @default(1)
  earlyBreakPenaltyPct Decimal  @default(0.05) @db.Decimal(5, 4)
  isLocked             Boolean  @default(true)

  // Timeline
  startDate    DateTime  @default(now())
  maturityDate DateTime
  completedAt  DateTime?
  brokenAt     DateTime?

  // Auto-deposit rule (1:1 with vault — null means manual-only)
  autoRuleEnabled    Boolean         @default(false)
  autoRuleAmountUsdc Decimal?        @db.Decimal(20, 8)
  autoRuleFrequency  VaultFrequency?
  autoRuleNextRun    DateTime? // cron scans this column

  // Gamification
  streakCount      Int     @default(0)
  longestStreak    Int     @default(0)
  missedCount      Int     @default(0)
  consistencyScore Decimal @default(0) @db.Decimal(5, 2)
  totalAzmEarned   Decimal @default(0) @db.Decimal(20, 8)

  // Receipt snapshot (denormalised on completion for fast UI render)
  receiptSnapshot Json?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits VaultDeposit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([autoRuleEnabled, autoRuleNextRun])
  @@index([status, maturityDate])
}

model VaultDeposit {
  id         String             @id @default(uuid())
  vaultId    String
  userId     Int
  amountUsdc Decimal            @db.Decimal(20, 8)
  type       VaultDepositType
  status     VaultDepositStatus @default(COMPLETED)

  // AZM intensity reward breakdown (rendered verbatim in the FE explainer)
  azmAwarded   Decimal @default(0) @db.Decimal(20, 8)
  azmBreakdown Json?

  // For AUTO_RULE: did the cron find idle funds?
  scheduledFor  DateTime?
  attemptedAt   DateTime  @default(now())
  failureReason String?

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([vaultId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// ── PHASE 2: GROUP CHAT + SUSU ─────────────────────────────────────────────
//
// Group chat is a parallel surface to DirectMessage (which is friend-pair
// scoped). Conversation is reserved for trade rooms — both stay untouched.
// Groups can be Susu-enabled by binding a SusuGroup row.
// =============================================================================

model GroupChat {
  id          String          @id @default(uuid())
  name        String          @db.VarChar(80)
  description String?         @db.VarChar(280)
  avatarUrl   String?
  createdById Int
  status      GroupChatStatus @default(ACTIVE)

  // 1:0..1 binding to SusuGroup. Set when admin starts a susu inside the group.
  susuGroupId String? @unique

  members      GroupMember[]
  messages     GroupMessage[]
  vouchRecords VouchRecord[]
  joinRequests GroupJoinRequest[]
  susuGroup    SusuGroup?     @relation("GroupSusu", fields: [susuGroupId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("GroupChatCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

model GroupMember {
  id            String    @id @default(uuid())
  groupId       String
  userId        Int
  role          GroupRole @default(MEMBER)
  joinedAt      DateTime  @default(now())
  removedAt     DateTime?
  removedReason String?

  // PHASE 6: vouch lineage. addedById = who added/vouched for this member
  // (admin self-add → admin; member proposal → proposer). vouchedById = the
  // resolved voucher for Susu purposes (defaults to addedById). These let the
  // initiation split compute Vouched/Unvouched without a separate join, and
  // VouchRecord creation pulls voucherId from vouchedById at activation.
  addedById   Int?
  vouchedById Int?

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

// ── PHASE 6: GROUP JOIN REQUEST (member-proposed add → admin approval) ──────
// A persisted proposal by one group member (the proposer / voucher-to-be) to
// add a target user to a group. Pending until the admin approves or rejects.
// On approval the target becomes a GroupMember with vouchedById = proposerId.
model GroupJoinRequest {
  id           String                 @id @default(uuid())
  groupId      String
  proposerId   Int // the voucher-to-be
  targetUserId Int
  note         String? // free-text reason, surfaced in notifications
  status       GroupJoinRequestStatus @default(PENDING)
  decidedById  Int? // admin who approved/rejected
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())

  group    GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposer User      @relation("GJRProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  target   User      @relation("GJRTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, targetUserId, status])
  @@index([groupId, status])
  @@index([targetUserId, status])
}

model GroupMessage {
  id       String  @id @default(uuid())
  groupId  String
  senderId Int?
  type     String // TEXT | IMAGE | VIDEO | DOCUMENT | AUDIO | LINK | SYSTEM | SUSU_EVENT | VOUCH_REQUEST
  content  String?
  metadata Json?

  // Same media columns as DirectMessage / TicketMessage
  mediaUrl           String?
  mediaType          String?
  mediaMimeType      String?
  mediaSize          Int?
  mediaDuration      Int?
  mediaWaveformPeaks Json?
  linkPreview        Json?

  group  GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User?     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([senderId])
}

model VouchRecord {
  id           String  @id @default(uuid())
  groupId      String
  inviteeId    Int? // nullable: pre-registration vouches link by phone
  inviteePhone String? // phone-based vouch target (auto-linked on signup)
  voucherId    Int
  isInviter    Boolean @default(false)

  // The Vouch Form payload
  relationship        String  @db.VarChar(80)
  durationKnown       String  @db.VarChar(40)
  reasonForTrust      String  @db.VarChar(500)
  acknowledgesPenalty Boolean @default(false)

  status      VouchStatus @default(PENDING)
  submittedAt DateTime?

  group   GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee User?     @relation("VouchInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  voucher User      @relation("VouchVoucher", fields: [voucherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, inviteeId])
  @@index([voucherId])
  @@index([status])
  @@index([inviteePhone]) // registration hook scans this
}

model SusuGroup {
  id        String     @id @default(uuid())
  groupChat GroupChat? @relation("GroupSusu")

  status                SusuStatus    @default(CONFIGURING)
  contributionUsdc      Decimal       @db.Decimal(20, 8)
  frequency             SusuFrequency
  totalCycles           Int
  startDate             DateTime
  contractAcceptedCount Int           @default(0)
  contractRequiredCount Int

  // Smart-rotation snapshot at start (immutable order for UI)
  rotationSnapshot Json

  // ── PRIVATE SUSU ECOSYSTEM (2026-05-31) ────────────────────────────────
  // Liability_Contract version pinned at activation time (Req 4.10)
  contractVersion String?
  contractHash    String?
  // Activation timestamp distinct from startDate so we can tell pre-activation
  // Susus apart from active ones (Req 8.7)
  activatedAt     DateTime?
  // Circuit Breaker freeze record (Req 11.9)
  frozenAt        DateTime?
  frozenReason    String?

  // ── PHASE 5 / Workstream D (2026-06-01): Group-chat-first initiation ──
  // When an admin clicks "Initiate Susu" inside a group chat, the SusuGroup
  // is created in CONFIGURING with an initiation countdown. Every member
  // must reach KYC=VERIFIED + PoR=VERIFIED + contract acceptance before the
  // deadline, or the initiation-sweep worker removes them from the group
  // and either activates with the verified set or aborts.
  initiationDeadline DateTime?
  initiatedById      Int?

  members              SusuMember[]
  cycles               SusuCycle[]
  invites              SusuInvite[]
  liabilityAcceptances LiabilityAcceptance[]
  voucherSlashLogs     VoucherSlashLog[]
  reminderRows         SusuReminderSent[]
  warRoomAlerts        AdminWarRoomAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
}

model SusuMember {
  id                 String           @id @default(uuid())
  susuGroupId        String
  userId             Int
  cycleSlot          Int
  trustScore         Decimal          @db.Decimal(8, 4)
  status             SusuMemberStatus @default(PENDING_CONTRACT)
  contractAcceptedAt DateTime?

  // Vouch chain that admitted this member
  inviterId   Int?
  vouchedById Int?

  // Default tracking
  defaultedAt     DateTime?
  totalSeizedUsdc Decimal   @default(0) @db.Decimal(20, 8)

  // ── PHASE 5 / Workstream B (2026-06-01): auto-retain opt-in ──
  // When true, the member has asked the platform to keep the next
  // contribution amount reserved from their availableBalance after a
  // payout, so the upcoming cycle self-funds without a manual top-up.
  // Honoured by the Reminder_Cron / cycle funding logic (Workstream C).
  autoRetainNextCycle Boolean @default(false)

  susu          SusuGroup          @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  user          User               @relation("SusuMembership", fields: [userId], references: [id], onDelete: Cascade)
  contributions SusuContribution[]
  reminderRows  SusuReminderSent[]

  @@unique([susuGroupId, userId])
  @@unique([susuGroupId, cycleSlot])
  @@index([userId])
  @@index([status])
}

model SusuCycle {
  id             String          @id @default(uuid())
  susuGroupId    String
  cycleNumber    Int
  collectionDate DateTime
  payoutAmount   Decimal         @db.Decimal(20, 8)
  payoutUserId   Int
  status         SusuCycleStatus @default(PENDING)

  paidOutAt     DateTime?
  defaultsCount Int       @default(0)

  // ── PRIVATE SUSU ECOSYSTEM (2026-05-31) ────────────────────────────────
  // Set when Cycle_Scheduler transitions PENDING → COLLECTING (Req 10.1)
  startedCollectingAt DateTime?
  // Non-null when payout was diverted to azaman-treasury because the
  // designated payoutUser had defaulted (Req 10.8)
  escrowDivertedAt    DateTime?

  // ── PHASE 5 / Workstream C (2026-06-01): Grace window deadline ──
  // Set when the cycle enters COLLECTING_GRACE. The Cycle_Scheduler keeps
  // re-evaluating the cycle while now() < graceUntil (members may top up
  // and fund); once now() >= graceUntil any still-short member is
  // hard-defaulted and the cycle is finalized.
  graceUntil          DateTime?

  // ── PHASE 6 / Phase 5 (2026-06-01): Susu Profit Engine ──
  // Platform fee deducted from the pooled contribution before payout.
  // Calculated as ROUND_DOWN(pooled × GlobalSettings.susuProfitPct).
  // Persisted for audit and transparency. takeHome = pooled - feeUsdc.
  feeUsdc             Decimal?                @db.Decimal(20, 8)

  susu             SusuGroup           @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  payoutUser       User                @relation("SusuCycleWinner", fields: [payoutUserId], references: [id])
  contributions    SusuContribution[]
  voucherSlashLogs VoucherSlashLog[]
  reminderRows     SusuReminderSent[]
  warRoomAlerts    AdminWarRoomAlert[]

  @@unique([susuGroupId, cycleNumber])
  @@index([status, collectionDate])
  @@index([payoutUserId])
}

model SusuContribution {
  id                  String                 @id @default(uuid())
  cycleId             String
  memberId            String
  userId              Int
  amountUsdc          Decimal                @db.Decimal(20, 8)
  status              SusuContributionStatus
  collectedAt         DateTime               @default(now())
  seizedFromAvailable Decimal                @default(0) @db.Decimal(20, 8)
  shortfall           Decimal                @default(0) @db.Decimal(20, 8)

  cycle  SusuCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member SusuMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user   User       @relation("SusuContributor", fields: [userId], references: [id])

  @@unique([cycleId, memberId])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// PRIVATE SUSU ECOSYSTEM — NEW TABLES (2026-05-31)
// =============================================================================
//
// Strictly additive overlay on the deployed SusuGroup / SusuMember /
// SusuCycle / SusuContribution / VouchRecord scaffolding. Each new table
// powers a specific requirement from
// .kiro/specs/private-susu-ecosystem/requirements.md:
//
//   SusuInvite               — Req 6 (three-channel invites)
//   LiabilityContractVersion — Req 4 (versioned contract bodies + hashes)
//   LiabilityAcceptance      — Req 4 (per-user / per-Susu acceptance audit)
//   VoucherSlashLog          — Req 7 (immutable AZM/trust slash record)
//   SusuReminderSent         — Req 13 (T-24h reminder idempotency)
//   AdminWarRoomAlert        — Req 10.12 / Req 11.9 (Circuit Breaker + escrow alerts)
//
// All tables key off SusuGroup.id (the existing Susu identifier). VouchRecord
// continues to power the rich Vouch-Form workflow; new SusuInvite rows
// trigger VouchRecord creation through SusuVouch_Service in Phase 2.
// =============================================================================

model SusuInvite {
  id            String            @id @default(uuid())
  susuGroupId   String
  inviterId     Int
  inviteeUserId Int? // null until a PHONE invite is bound to a verified phone
  inviteePhone  String? // E.164 normalised; populated only for PHONE channel
  channel       SusuInviteChannel
  token         String?           @unique // 32-byte URL-safe random for LINK channel only
  status        SusuInviteStatus  @default(PENDING)
  expiresAt     DateTime
  redeemedAt    DateTime?
  createdAt     DateTime          @default(now())

  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  inviter User      @relation("SusuInviteInviter", fields: [inviterId], references: [id])
  invitee User?     @relation("SusuInviteInvitee", fields: [inviteeUserId], references: [id])

  @@index([susuGroupId, status])
  @@index([inviteeUserId, status])
  @@index([inviteePhone, status])
}

model LiabilityContractVersion {
  id           String   @id @default(uuid())
  version      String   @unique // e.g. "v1.0", "v1.1"
  contractHash String   @unique // SHA-256 of body
  body         String   @db.Text
  publishedAt  DateTime @default(now())
  publishedBy  Int

  publisher User @relation("ContractPublisher", fields: [publishedBy], references: [id])

  @@index([publishedAt(sort: Desc)])
}

model LiabilityAcceptance {
  id              String   @id @default(uuid())
  userId          Int
  susuGroupId     String
  contractVersion String
  contractHash    String
  acceptedAt      DateTime @default(now())
  ipAddress       String
  userAgent       String

  // ── PHASE 6 / Phase 4 (2026-06-01): Consent & Voucher tracking ──────────
  // acknowledgedClauses: JSON array of clause keys the user ticked in the
  // Consent_Gate modal (e.g., ["seizure", "tracing", "named_voucher"]).
  // Persisted for audit and future enforcement. Nullable for backward
  // compatibility with existing acceptances.
  acknowledgedClauses Json?
  // voucherUserId: the User.id of the member who vouched for this user at
  // acceptance time. Nullable: null means the user was already a group member
  // (no vouch needed) or was auto-vouched by the initiator.
  voucherUserId       Int?

  user    User      @relation(fields: [userId], references: [id])
  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  voucher User?     @relation("LiabilityVoucher", fields: [voucherUserId], references: [id])

  @@unique([userId, susuGroupId, contractVersion])
  @@index([susuGroupId])
  @@index([voucherUserId])
}

model VoucherSlashLog {
  id                String   @id @default(uuid())
  voucherId         Int? // nullable for absent-vouch case (Req 7.4)
  vouchedUserId     Int
  susuGroupId       String
  cycleId           String
  azmDeducted       Decimal  @db.Decimal(20, 8)
  trustRatingBefore Int
  trustRatingAfter  Int
  appliedAt         DateTime @default(now())

  voucher User?     @relation("SlashVoucher", fields: [voucherId], references: [id])
  vouched User      @relation("SlashVouched", fields: [vouchedUserId], references: [id])
  susu    SusuGroup @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  cycle   SusuCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([susuGroupId, cycleId])
}

model SusuReminderSent {
  id           String   @id @default(uuid())
  susuMemberId String
  susuCycleId  String
  susuGroupId  String // denormalised for cleanup convenience
  reminderType String // 'T_24H_SHORTFALL' for now; expandable
  sentAt       DateTime @default(now())

  member SusuMember @relation(fields: [susuMemberId], references: [id], onDelete: Cascade)
  cycle  SusuCycle  @relation(fields: [susuCycleId], references: [id], onDelete: Cascade)
  susu   SusuGroup  @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)

  @@unique([susuMemberId, susuCycleId, reminderType])
  @@index([susuCycleId])
}

model AdminWarRoomAlert {
  id             String                @id @default(uuid())
  alertType      AdminWarRoomAlertType
  susuGroupId    String
  cycleId        String?
  payload        Json
  createdAt      DateTime              @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy Int?

  // ── PHASE 5 / Workstream E (2026-06-01): incident resolution ──
  // How the admin closed the incident from the War Room: RESUME (lift the
  // FROZEN_DISPUTE freeze and let cycles continue) or REFUND_AND_CLOSE
  // (return the frozen pool to members and cancel the Susu). Null until the
  // incident is resolved.
  resolution     String?
  resolvedAt     DateTime?
  resolvedBy     Int?

  susu  SusuGroup  @relation(fields: [susuGroupId], references: [id], onDelete: Cascade)
  cycle SusuCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  ackBy User?      @relation("AlertAcknowledger", fields: [acknowledgedBy], references: [id])

  @@index([acknowledgedAt, createdAt(sort: Desc)])
  @@index([susuGroupId])
}

// ── PHASE 3: SMART ROUTE ────────────────────────────────────────────────────

model SmartRoute {
  id         String              @id @default(uuid())
  userId     Int
  name       String              @db.VarChar(60)
  action     SmartRouteAction
  amountUsdc Decimal             @db.Decimal(20, 8)
  frequency  SmartRouteFrequency
  dayOfMonth Int?
  status     SmartRouteStatus    @default(ACTIVE)

  // Destination (one is set depending on `action`)
  destMomoNumber    String?
  destMomoProvider  String?
  destFriendUserId  Int?
  destSavingsGoalId String?
  destVaultId       String?

  startDate       DateTime
  endDate         DateTime?
  nextRunAt       DateTime
  lastRunAt       DateTime?
  totalRuns       Int       @default(0)
  totalRoutedUsdc Decimal   @default(0) @db.Decimal(20, 8)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs SmartRouteRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, nextRunAt])
}

model SmartRouteRun {
  id         String              @id @default(uuid())
  routeId    String
  userId     Int
  status     SmartRouteRunStatus
  amountUsdc Decimal             @db.Decimal(20, 8)
  amountGhs  Decimal?            @db.Decimal(20, 8)
  rateUsed   Decimal?            @db.Decimal(18, 8)

  withdrawalId  Int? // loose FK — no @relation to keep Withdrawal untouched
  failureReason String?

  route SmartRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User       @relation("SmartRouteRunUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([routeId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ── PHASE 4: AZM AUCTION (AD BOOST SINK) ───────────────────────────────────

model AzmAuction {
  id          String           @id @default(uuid())
  windowStart DateTime
  windowEnd   DateTime
  status      AzmAuctionStatus @default(OPEN)

  leaderboard    Json?
  winnerCount    Int       @default(3)
  totalAzmBurned Decimal   @default(0) @db.Decimal(20, 8)
  settledAt      DateTime?

  bids AzmAuctionBid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([windowStart, windowEnd])
  @@index([status])
  @@index([windowEnd])
}

model AzmAuctionBid {
  id           String       @id @default(uuid())
  auctionId    String
  vendorId     Int
  adId         Int
  bidAmountAzm Decimal      @db.Decimal(20, 8)
  status       AzmBidStatus @default(ACTIVE)

  rank         Int?
  azmBurned    Decimal   @default(0) @db.Decimal(20, 8)
  boostedUntil DateTime?

  auction AzmAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  vendor  User       @relation("AuctionBidder", fields: [vendorId], references: [id], onDelete: Cascade)
  ad      Ad         @relation("AuctionAd", fields: [adId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auctionId, vendorId])
  @@index([auctionId, bidAmountAzm(sort: Desc)])
  @@index([vendorId])
  @@index([adId])
}

// =============================================================================
// SAVED MOMO ACCOUNTS  (Master Sprint v2, 2026-05-27)
//
// Local-fiat deposit destinations the user pre-saves so the deposit screen
// can fire a STK-push prompt to a known/verified phone number with one tap.
// We never collect "payment" inputs at deposit time — the gateway sends the
// prompt to the saved phone, the user approves it on their phone, and the
// webhook credits availableBalance once the gateway confirms settlement.
//
// Save-time security:
//   • Backend re-verifies the user's password (or 2FA token) before persisting.
//   • Provider name lookup (mocked until Kotani Pay V3 ships the endpoint —
//     the field then just gets re-populated at first use).
// =============================================================================

model SavedMomoAccount {
  id          String    @id @default(uuid())
  userId      Int
  nickname    String    @db.VarChar(40) // user-chosen label e.g. "Mum's MTN"
  provider    String // MTN | VODAFONE | TELECEL
  phoneNumber String // E.164 string, unique per user+number
  accountName String? // resolved via provider lookup
  isVerified  Boolean   @default(false) // true once provider returns a name
  isPrimary   Boolean   @default(false) // user can mark one as default
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
  @@index([userId])
}
