// =============================================================================
// BUSINESS NOTIFICATION (2026-06-17)
// Persistent, owner-facing notification feed surfaced in the Business Portal.
// Distinct from the per-user Notification model: a BusinessNotification is keyed
// to a BusinessProfile (not a userId) so it stays correct even if ownership of
// the business is ever transferred. Written fire-and-forget alongside the order
// lifecycle — never inside a financial $transaction.
// =============================================================================
enum BizNotifType {
  NEW_ORDER // a customer opened an escrow order against this business
  ORDER_FUNDED // the buyer funded the escrow
  ORDER_SATISFIED // the buyer marked the order satisfied
  ORDER_DISPUTED // a dispute was raised on the order
  ORDER_SETTLED // escrow released — funds delivered to the business
  ORDER_CANCELLED // a DRAFT order was cancelled before funding
  ORDER_REFUNDED // escrow refunded to the buyer
  KYB_STATUS_CHANGED // verification status changed (approved/rejected)
  INVOICE_PAID // a sent invoice was paid by the customer
  RESERVATION_NEW
  RESERVATION_CONFIRMED
  RESERVATION_CHECKED_IN
  RESERVATION_NO_SHOW
  TRANSIT_BOOKING_NEW
  TRANSIT_NO_SHOW
  INVOICE_SENT
  FOLLOWED_BUSINESS
  AD_POST_CREATED
  DINE_IN_TAB_OPENED
  DINE_IN_TAB_FINALIZED
  DINE_IN_TAB_PAID
  PENALTY_CHARGED
  PENALTY_REFUNDED
  TRUST_LEVEL_CHANGED
  TRANSIT_REMINDER
  COUNTER_PROPOSAL
}

